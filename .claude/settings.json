{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile:*)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm content:check)",
      "Bash(pnpm format:check)",
      "Bash(pnpm format:write)",
      "Bash(pnpm lint:check)",
      "Bash(pnpm lint)",
      "Bash(pnpm types:check)",
      "Bash(pnpm test)",
      "Bash(pnpm test:coverage)",
      "Bash(pnpm vitest run:*)",
      "Bash(pnpm exec prettier --check:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push --set-upstream origin main:*)",
      "Bash(git push origin preview:*)",
      "Bash(git push origin HEAD:preview:*)",
      "Bash(git push -u origin preview:*)",
      "Bash(git push --set-upstream origin preview:*)"
    ]
  }
}
