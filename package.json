{
  "name": "astro-portfolio-website",
  "version": "0.24.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "astro preview",
    "restart-prod": "astro build && astro preview",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings=0",
    "lint:write": "eslint --fix . && prettier --write .",
    "format-lint": "prettier --write . && eslint --fix .",
    "types:check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/gabarito": "^5.3.0",
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/fa": "^1.2.2",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/lucide": "^1.2.123",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "astro": "^7.2.2",
    "astro-icon": "^1.1.5",
    "clsx": "2.1.1",
    "highlight.js": "11.11.1",
    "satori": "^0.29.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "26.1.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "schema-dts": "2.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,astro}": "eslint --max-warnings=0",
    "*.{js,ts,mjs,cjs,json,css,md,mdx,yml,yaml,astro}": "prettier --check"
  }
}
