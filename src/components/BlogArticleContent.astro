---
import { render } from "astro:content"
import ArticleSheet from "@/components/ArticleSheet.astro"
import BlogCard from "@/components/BlogCard.astro"
import { getAllBlogPosts, type BlogPost } from "@/lib/content"
import { copy, getLocalizedPath, type Locale } from "@/lib/i18n"
import { formatBlogDate, getRelatedPosts } from "@/lib/utils"

interface Props {
  post: BlogPost
  locale: Locale
}

const { post, locale } = Astro.props
const { Content, headings } = await render(post.entry)
const related = getRelatedPosts(post, await getAllBlogPosts(locale, { featuredOnly: false }))
const labels = copy[locale].article
// getAllBlogPosts falls back to the English post when there is no translation for the locale
const untranslated = post.locale !== locale
const contentLang = untranslated ? post.locale : undefined
const updated = post.updatedAt !== post.publishedAt
const path = [
  `blog/${post.slug}`,
  formatBlogDate(post.publishedAt, "short", locale).toLowerCase(),
  updated && `↻ ${formatBlogDate(post.updatedAt, "short", locale).toLowerCase()}`,
  `${post.readingTime} ${labels.minRead}`,
]
  .filter(Boolean)
  .join(" · ")
const tilts = ["-0.8deg", "0.6deg", "-0.4deg"]
---

<ArticleSheet
  backHref={getLocalizedPath("/blog", locale)}
  backLabel={labels.back}
  path={path}
  title={post.title}
  description={post.summary}
  headings={headings}
  contentLang={contentLang}
  pagefind={!untranslated}
  pagefindSection={copy[locale].nav.blog}
>
  <Fragment slot="meta">
    {post.tags && (
      <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-1" aria-label={labels.tags} data-pagefind-ignore>
        {post.tags.map(tag => (
          <li>
            <a
              href={getLocalizedPath(`/blog/tag/${encodeURIComponent(tag.toLowerCase())}`, locale)}
              class="flag text-sm"
            >
              {tag.toLowerCase().replaceAll(" ", "-")}
            </a>
          </li>
        ))}
      </ul>
    )}
    {untranslated && (
      <p class="note tape mt-8 rounded-sm px-5 py-4 text-sm leading-relaxed" role="note">
        {copy[locale].untranslated.notice}{" "}
        <a
          href={`/blog/${post.slug}`}
          data-locale-option="en"
          hreflang="en"
          class="font-semibold underline underline-offset-2"
        >
          {copy[locale].untranslated.link}
        </a>
      </p>
    )}
  </Fragment>
  <Content />
  <Fragment slot="after">
    {related.length > 0 && (
      <section class="mt-20" data-pagefind-ignore>
        <p class="eyebrow">$ ls ../related</p>
        <h2 class="display mt-3 text-3xl text-ink">{labels.related}</h2>
        <div class="mt-8 grid gap-8 md:grid-cols-3">
          {related.map((entry, index) => (
            <div data-reveal style={`--delay: ${index * 0.1}s`}>
              <BlogCard post={entry} locale={locale} tilt={tilts[index % 3]} />
            </div>
          ))}
        </div>
      </section>
    )}
  </Fragment>
</ArticleSheet>
