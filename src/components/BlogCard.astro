---
import { Icon } from "astro-icon/components"
import type { BlogPost } from "@/lib/content"
import type { Locale } from "@/lib/i18n"
import { getLocalizedPath } from "@/lib/i18n"
import { formatBlogDate } from "@/lib/utils"

interface Props {
  post: BlogPost
  locale?: Locale
  surface?: "default" | "contrast"
}
const { post, locale = "en", surface = "default" } = Astro.props
const actionLabel = { en: "Read article", es: "Leer artículo", "pt-br": "Ler artigo" }[locale]
const surfaceClass =
  surface === "contrast" ? "border-[#2e3440] bg-[#3b4252]" : "border-white/20 bg-white/[0.06]"
const articlePath = getLocalizedPath(`/blog/${post.slug}`, locale)
---

<article
  class={`blog-card group flex h-full flex-col border p-6 text-white transition duration-200 hover:-translate-y-1 hover:border-[#88c0d0] ${surfaceClass} ${surface === "default" ? "hover:bg-white/[0.1]" : "hover:bg-[#434c5e]"}`}
>
  <h3 class="display-type text-2xl leading-tight">
    <a href={articlePath}>{post.title}</a>
  </h3>
  <p class="mt-4 grow leading-relaxed text-white/65">{post.summary}</p>
  <div class="mt-6 flex items-center gap-3 font-mono text-xs font-bold text-[#8fbcbb] uppercase">
    <time datetime={post.publishedAt}>{formatBlogDate(post.publishedAt, "short")}</time>
    <span>·</span>
    <span>{post.readingTime} min read</span>
  </div>
  <ul class="mt-4 flex flex-wrap gap-2" aria-label="Article tags">
    {
      (post.tags?.length ? post.tags : ["Engineering"]).map(tag => (
        <li>
          <a
            href={getLocalizedPath(`/blog/tag/${encodeURIComponent(tag.toLowerCase())}`, locale)}
            class="inline-flex border border-[#8fbcbb]/55 px-2 py-1 font-mono text-[0.65rem] leading-none font-bold tracking-[0.13em] text-[#8fbcbb] uppercase transition hover:border-[#88c0d0] hover:bg-[#88c0d0] hover:text-[#2e3440] focus-visible:border-[#88c0d0] focus-visible:bg-[#88c0d0] focus-visible:text-[#2e3440] focus-visible:outline-none"
          >
            {tag}
          </a>
        </li>
      ))
    }
  </ul>
  <a
    href={articlePath}
    class="mt-6 inline-flex items-center gap-2 font-mono text-xs font-bold tracking-[0.14em] text-white uppercase"
    >{actionLabel}
    <Icon name="lucide:arrow-right" class="size-4 transition group-hover:translate-x-1" /></a
  >
</article>
