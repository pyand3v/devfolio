---
import { Icon } from "astro-icon/components"
import type { BlogPost } from "@/lib/content"
import { copy, getLocalizedPath, type Locale } from "@/lib/i18n"
import { formatBlogDate } from "@/lib/utils"

// A post as a pinned paper card, or as a sticky note on the home page
interface Props {
  post: BlogPost
  locale?: Locale
  variant?: "card" | "note"
  tilt?: string
}
const { post, locale = "en", variant = "card", tilt = "0deg" } = Astro.props
const labels = copy[locale].article
const articlePath = getLocalizedPath(`/blog/${post.slug}`, locale)
// Untranslated posts are listed in English, so mark their text as such for screen readers and translators
const contentLang = post.locale !== locale ? post.locale : undefined
const tags = post.tags?.length ? post.tags : ["Engineering"]
const isNote = variant === "note"
const readingTime = `${post.readingTime} ${labels.minRead}`
---

<article
  class:list={[
    "blog-card group relative flex h-full flex-col rounded-sm p-6",
    isNote ? "note tape" : "card-paper",
  ]}
  style={`--tilt: ${tilt}`}
>
  <p class:list={["font-mono text-xs", isNote ? "text-note-accent" : "text-muted"]}>
    <time datetime={post.publishedAt}>{formatBlogDate(post.publishedAt, "short", locale)}</time>
    <span aria-hidden="true"> · </span>
    {readingTime}
  </p>
  <h3
    class:list={["display mt-3 text-2xl", isNote ? "text-note-ink" : "text-ink"]}
    lang={contentLang}
  >
    <a href={articlePath} class="after:absolute after:inset-0 after:content-['']">
      {post.title}
    </a>
  </h3>
  <p
    class:list={[
      "mt-3 grow leading-relaxed",
      isNote ? "line-clamp-3 text-note-ink/85" : "text-ink-soft",
    ]}
    lang={contentLang}
  >
    {post.summary}
  </p>
  <ul class="relative z-10 mt-5 flex flex-wrap gap-x-3 gap-y-1" aria-label={labels.tags}>
    {tags.slice(0, isNote ? 3 : 5).map(tag => (
      <li>
        <a
          href={getLocalizedPath(`/blog/tag/${encodeURIComponent(tag.toLowerCase())}`, locale)}
          class:list={["flag", isNote && "text-note-accent"]}
        >
          {tag.toLowerCase().replaceAll(" ", "-")}
        </a>
      </li>
    ))}
  </ul>
  {!isNote && (
    <span class="link-arrow mt-5" aria-hidden="true">
      {labels.read}
      <Icon name="lucide:arrow-right" class="size-4" />
    </span>
  )}
</article>
