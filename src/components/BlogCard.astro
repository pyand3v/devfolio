---
import { Icon } from "astro-icon/components"
import type { BlogPost } from "@/lib/content"
import { formatBlogDate } from "@/lib/utils"

interface Props {
  post: BlogPost
}
const { post } = Astro.props
---

<article
  class="blog-card group relative flex h-full flex-col overflow-hidden rounded-xl border border-gray-300 bg-white p-5 pl-6 shadow-sm transition-[border-color,box-shadow,background-color,transform] duration-200 hover:-translate-y-0.5 hover:border-accent-500 hover:shadow-xl hover:shadow-accent-500/10 dark:border-gray-700 dark:bg-gray-900 dark:hover:bg-gray-800"
>
  <span aria-hidden="true" class="absolute inset-y-0 left-0 w-1 bg-accent-500"></span>
  {
    post.tags?.[0] && (
      <p class="blog-card-topic mb-2 text-xs font-bold tracking-[0.14em] text-accent-600 uppercase dark:text-accent-400">
        {post.tags[0]}
      </p>
    )
  }
  <h3
    class="text-lg font-bold text-gray-900 transition-colors group-hover:text-accent-600 dark:text-white dark:group-hover:text-accent-400"
  >
    <a href={`/blog/${post.slug}`} class="focus-visible:outline-none">{post.title}</a>
  </h3>
  <div
    class="blog-card-meta mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-600 dark:text-gray-400"
  >
    <span class="flex items-center gap-2 whitespace-nowrap"
      ><Icon name="lucide:calendar-days" class="size-3.5" /><time datetime={post.date}
        >{formatBlogDate(post.date, "short")}</time
      ></span
    >
    <span class="flex items-center gap-2 whitespace-nowrap"
      ><Icon name="lucide:book-open" class="size-3.5" />{post.readingTime} min read</span
    >
  </div>
  {
    post.tags && post.tags.length > 0 && (
      <div class="blog-card-tags mt-3 flex flex-wrap gap-2">
        {post.tags.map(tag => (
          <a
            href={`/blog/tag/${encodeURIComponent(tag)}`}
            class="rounded-full bg-accent-500/10 px-2 py-0.5 text-xs font-semibold text-accent-700 transition hover:bg-accent-500/20 dark:text-accent-400"
          >
            <Icon name="lucide:tag" class="mr-1 inline size-3" />
            {tag}
          </a>
        ))}
      </div>
    )
  }
  <p
    class="blog-card-summary mt-3 grow text-sm leading-relaxed text-gray-700 line-clamp-2 dark:text-gray-300"
  >
    {post.summary}
  </p>
  <a
    href={`/blog/${post.slug}`}
    class="blog-card-cta mt-4 inline-flex w-fit items-center gap-1.5 rounded-lg bg-accent-500/10 px-3 py-1.5 text-sm font-bold text-accent-700 transition hover:bg-accent-500 hover:text-white group-hover:bg-accent-500 group-hover:text-white dark:text-accent-400"
    >Read article <Icon name="lucide:arrow-right" class="size-4" /></a
  >
</article>
