---
import { render } from "astro:content"
import { Icon } from "astro-icon/components"
import ArticleSheet from "@/components/ArticleSheet.astro"
import type { ByoExercise, ByoGuide, ByoLesson, ByoProjectBundle } from "@/lib/content"
import { copy, getLocalizedPath, type Locale } from "@/lib/i18n"
import byoProgress from "@/scripts/byo-progress.js?raw"

interface Props {
  bundle: ByoProjectBundle
  entry: ByoLesson | ByoGuide | ByoExercise
  locale: Locale
}
const { bundle, entry, locale } = Astro.props
const { Content, headings } = await render(entry)
const labels = copy[locale].byo
const project = bundle.project.data
const base = `/byo/${project.slug}`
const lessonEntry = entry.data.type === "lesson" ? (entry as ByoLesson) : undefined
const lessonIndex = lessonEntry ? bundle.lessons.findIndex(item => item.id === lessonEntry.id) : -1
const previous = lessonEntry ? bundle.lessons[lessonIndex - 1] : undefined
const next = lessonEntry ? bundle.lessons[lessonIndex + 1] : undefined
const chapter = lessonEntry
  ? project.chapters.find(item => item.order === lessonEntry.data.chapter)
  : undefined
const kind =
  entry.data.type === "lesson"
    ? labels.lesson
    : entry.data.type === "guide"
      ? labels.guide
      : labels.exercise
const folder = { lesson: "lessons", guide: "guides", exercise: "exercises" }[entry.data.type]
const path = [
  `byo/${project.slug}/${folder}/${entry.data.slug}`,
  lessonEntry && chapter?.title,
  lessonEntry && `${labels.lesson} ${lessonIndex + 1} ${labels.of} ${bundle.lessons.length}`,
  !lessonEntry && kind,
]
  .filter(Boolean)
  .join(" · ")
// Long courses drop the connectors so the numbered stops wrap into tidy rows
const compactTrail = bundle.lessons.length > 8
const lessonHref = (slug: string) => getLocalizedPath(`${base}/lessons/${slug}`, locale)
---

<ArticleSheet
  backHref={getLocalizedPath(base, locale)}
  backLabel={labels.backToPath}
  path={path}
  title={entry.data.title}
  description={entry.data.description}
  headings={headings}
  pagefindSection={`BYO · ${project.title}`}
>
  <Fragment slot="meta">
    {lessonEntry && (
      <ol
        class:list={["mt-7 flex flex-wrap items-center", compactTrail ? "gap-1.5" : "gap-2"]}
        aria-label={`${project.title}: ${labels.lesson} ${lessonIndex + 1} ${labels.of} ${bundle.lessons.length}`}
        data-pagefind-ignore
        data-byo-course={project.slug}
        data-byo-visit={lessonEntry.data.slug}
        data-byo-total={bundle.lessons.length}
      >
        {bundle.lessons.map((lesson, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && !compactTrail && (
              <span class="w-4 border-t-2 border-dashed border-line sm:w-6" aria-hidden="true" />
            )}
            <a
              href={lessonHref(lesson.data.slug)}
              aria-current={index === lessonIndex ? "step" : undefined}
              title={lesson.data.title}
              class="byo-stop size-7 text-xs hover:border-accent"
              data-byo-stop={lesson.data.slug}
              data-number={index + 1}
            >
              <span class="sr-only">{labels.lesson} </span>
              {index + 1}
            </a>
          </li>
        ))}
      </ol>
    )}
    {lessonEntry && <script is:inline set:html={byoProgress} />}
  </Fragment>
  <Content />
  <Fragment slot="footer">
    {lessonEntry && (
      <nav
        data-pagefind-ignore
        class="mt-14 grid gap-4 border-t-[1.5px] border-dashed border-line pt-8 sm:grid-cols-2"
        aria-label={copy[locale].a11y.lessonNav}
      >
        {previous ? (
          <a href={lessonHref(previous.data.slug)} class="card-paper group block rounded-md p-4">
            <span class="inline-flex items-center gap-1.5 font-mono text-xs text-accent">
              <Icon name="lucide:arrow-left" class="size-3.5" />
              {labels.previous}
            </span>
            <span class="display mt-1.5 block text-lg text-ink">{previous.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a
            href={lessonHref(next.data.slug)}
            class="card-paper group block rounded-md p-4 text-right"
          >
            <span class="inline-flex items-center gap-1.5 font-mono text-xs text-accent">
              {labels.next}
              <Icon name="lucide:arrow-right" class="size-3.5" />
            </span>
            <span class="display mt-1.5 block text-lg text-ink">{next.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </Fragment>
</ArticleSheet>
