---
import ByoPathCard from "@/components/ByoPathCard.astro"
import SectionHeader from "@/components/SectionHeader.astro"
import type { ByoProjectBundle } from "@/lib/content"
import { copy, type Locale } from "@/lib/i18n"

interface Props {
  bundles: ByoProjectBundle[]
  locale: Locale
}
const { bundles, locale } = Astro.props
const labels = copy[locale].byo
---

<section class="mx-auto max-w-6xl px-4 pt-14 pb-10 sm:px-6 lg:pt-20">
  <SectionHeader
    level="h1"
    eyebrow={labels.eyebrow}
    title={labels.title}
    description={labels.description}
  >
    <p class="mt-5 font-mono text-xs text-muted">
      <span class="text-accent" aria-hidden="true">
        $ ls byo/ ·{" "}
      </span>
      {`${bundles.length} ${labels.paths}`}
    </p>
  </SectionHeader>
  <div class="mt-12 grid gap-8 md:grid-cols-3">
    {bundles.map((bundle, index) => (
      <div data-reveal style={`--delay: ${index * 0.12}s`}>
        <ByoPathCard bundle={bundle} index={index} locale={locale} />
      </div>
    ))}
  </div>
</section>
