---
import { Icon } from "astro-icon/components"
import TitleLines from "@/components/TitleLines.astro"
import type { ByoProjectBundle } from "@/lib/content"
import { copy, getLocalizedPath, type Locale } from "@/lib/i18n"
import byoProgress from "@/scripts/byo-progress.js?raw"

interface Props {
  bundle: ByoProjectBundle
  locale: Locale
}
const { bundle, locale } = Astro.props
const labels = copy[locale].byo
const { project, lessons, guides, exercises } = bundle
const base = `/byo/${project.data.slug}`
const lessonHref = (slug: string) => getLocalizedPath(`${base}/lessons/${slug}`, locale)
// Lessons are numbered across the whole course, as on its card and the lesson trail
const chapterLessons = project.data.chapters.map(chapter => ({
  ...chapter,
  lessons: lessons
    .map((lesson, index) => ({ lesson, number: index + 1 }))
    .filter(({ lesson }) => lesson.data.chapter === chapter.order),
}))
const firstLesson = lessons[0]
const stats = [
  `${project.data.chapters.length} ${labels.chapters}`,
  `${lessons.length} ${labels.lessons}`,
  `~${project.data.estimatedMinutes} ${labels.minutes}`,
].join(" · ")
const pad = (value: number) => String(value).padStart(2, "0")
const tilts = ["-0.8deg", "0.6deg", "-0.4deg", "0.9deg"]
---

<section
  class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14"
  data-byo-course={project.data.slug}
  data-byo-total={lessons.length}
>
  <a href={getLocalizedPath("/byo", locale)} class="link-arrow">
    <Icon name="lucide:arrow-left" class="size-4" />
    {labels.allPaths}
  </a>
  <header
    class="mt-10 grid gap-8 border-b-[1.5px] border-dashed border-line pb-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-end"
    data-pagefind-body
    data-pagefind-meta="section:BYO"
  >
    <div>
      <p class="eyebrow">BYO · {project.data.slug}</p>
      <h1 class="display mt-4 text-5xl text-ink sm:text-6xl">
        <TitleLines text={project.data.title} underline />
      </h1>
    </div>
    <div>
      <p class="text-lg leading-relaxed text-ink-soft">{project.data.description}</p>
      <p class="mt-4 font-mono text-xs text-muted">{stats}</p>
      <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-3">
        {firstLesson && (
          <a href={lessonHref(firstLesson.data.slug)} class="btn-ink" data-byo-fresh>
            <Icon name="lucide:play" class="size-4" />
            {labels.start}
          </a>
        )}
        <a
          href={firstLesson ? lessonHref(firstLesson.data.slug) : base}
          class="btn-ink"
          data-byo-continue
          data-label={labels.continueLesson}
          hidden
        >
          <Icon name="lucide:play" class="size-4" />
          <span data-text>{labels.continueLesson}</span>
        </a>
        <p class="font-mono text-xs text-muted" data-byo-count data-label={labels.opened} hidden />
        <button
          type="button"
          class="font-mono text-xs text-muted underline decoration-dashed underline-offset-4 transition hover:text-annot"
          data-byo-reset
          hidden
        >
          {labels.resetProgress}
        </button>
      </div>
    </div>
  </header>

  <section class="mt-14">
    <p class="eyebrow">01 · {labels.curriculum}</p>
    <div class="mt-8 grid gap-8">
      {chapterLessons.map(chapter => (
        <section class="sheet rounded-md px-5 py-6 sm:px-8" data-animate>
          <div class="grid gap-6 md:grid-cols-[15rem_1fr]">
            <div>
              <p class="font-mono text-xs text-accent">
                {labels.chapter} {pad(chapter.order)}
              </p>
              <h2 class="display mt-2 text-2xl text-ink">{chapter.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-muted">{chapter.description}</p>
            </div>
            <div class="relative">
              <span
                class="absolute top-4 bottom-4 left-[0.6875rem] border-l-2 border-dashed border-line"
                aria-hidden="true"
              />
              <ol class="relative grid gap-1">
                {chapter.lessons.map(({ lesson, number }, index) => (
                  <li>
                    <a
                      href={lessonHref(lesson.data.slug)}
                      class="group flex items-start gap-4 rounded-md py-2.5 pr-3 transition hover:bg-accent-soft"
                    >
                      <span
                        class="byo-stop pop size-6 text-[0.6875rem] group-hover:border-accent"
                        style={`--delay: ${0.1 + index * 0.1}s`}
                        aria-hidden="true"
                        data-byo-stop={lesson.data.slug}
                        data-number={number}
                        data-href={lessonHref(lesson.data.slug)}
                        data-start={number === 1 || undefined}
                      >
                        {number}
                      </span>
                      <span class="min-w-0 flex-1">
                        <span class="block font-medium text-ink">
                          {lesson.data.title}
                          <span
                            class="hand ml-2 inline-block -rotate-2 text-lg font-medium text-annot"
                            data-byo-left-off={lesson.data.slug}
                            hidden
                          >
                            ← {labels.leftOff}
                          </span>
                        </span>
                        <span class="mt-0.5 block text-sm text-muted">
                          {lesson.data.description}
                        </span>
                      </span>
                      <Icon
                        name="lucide:arrow-right"
                        class="mt-1 size-4 flex-none text-accent opacity-0 transition group-hover:translate-x-0.5 group-hover:opacity-100"
                      />
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        </section>
      ))}
    </div>
  </section>

  <div class="mt-16 grid gap-12 lg:grid-cols-2">
    {guides.length > 0 && (
      <section>
        <p class="eyebrow">02 · {labels.guidesTitle}</p>
        <div class="mt-6 grid gap-6">
          {guides.map((guide, index) => (
            <a
              href={getLocalizedPath(`${base}/guides/${guide.data.slug}`, locale)}
              class="card-paper block rounded-md p-5"
              style={`--tilt: ${tilts[index % tilts.length]}`}
            >
              <p class="font-mono text-xs text-accent">{labels.guide}</p>
              <h2 class="display mt-1.5 text-xl text-ink">{guide.data.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{guide.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}
    {exercises.length > 0 && (
      <section>
        <p class="eyebrow">03 · {labels.exercisesTitle}</p>
        <div class="mt-6 grid gap-6">
          {exercises.map((exercise, index) => (
            <a
              href={getLocalizedPath(`${base}/exercises/${exercise.data.slug}`, locale)}
              class="block"
            >
              <div
                class="note tape rounded-sm p-5"
                style={`--tilt: ${tilts[(index + 1) % tilts.length]}`}
              >
                <p class="flex items-center justify-between gap-3 font-mono text-xs text-note-accent">
                  {labels.exercise}
                  <span class="flag text-note-accent">{exercise.data.difficulty}</span>
                </p>
                <h2 class="display mt-1.5 text-xl">{exercise.data.title}</h2>
                <p class="mt-2 text-sm leading-relaxed">{exercise.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</section>
<script is:inline set:html={byoProgress} />
