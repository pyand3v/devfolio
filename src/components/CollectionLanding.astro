---
import BlogCard from "@/components/BlogCard.astro"
import { Icon } from "astro-icon/components"
import ProjectCard from "@/components/ProjectCard.astro"
import WorkCard from "@/components/WorkCard.astro"
import { groupBlogTags } from "@/data/blog-tags"
import type { Locale } from "@/lib/i18n"
import { copy } from "@/lib/i18n"
import { getAllBlogPosts, getAllProjects, getAllWorkItems } from "@/lib/content"

interface Props {
  locale: Locale
  kind: "work" | "projects" | "blog"
}

const { locale, kind } = Astro.props
const labels = copy[locale][kind]
const [work, projects, posts] = await Promise.all([
  getAllWorkItems(),
  getAllProjects(),
  getAllBlogPosts(locale),
])
const titleLines = labels.title.split("\n")
const blogTags = [...new Map(posts.flatMap(post => post.tags ?? []).map(tag => [tag, 0]))]
  .map(([tag]) => ({
    tag,
    count: posts.filter(post => post.tags?.includes(tag)).length,
  }))
  .sort((a, b) => a.tag.localeCompare(b.tag))
const groupedBlogTags = groupBlogTags(blogTags, locale)
const blogFilterCopy = {
  en: {
    label: "Filter by topic",
    all: "All articles",
    clear: "Clear all",
    selected: "topics selected",
    selectedTopics: "Selected topics",
    search: "Search topics...",
    noMatches: "No topics found.",
    remove: "Remove",
    results: "articles shown",
    empty: "No articles found for this topic.",
  },
  es: {
    label: "Filtrar por tema",
    all: "Todos los art\u00edculos",
    clear: "Limpiar todo",
    selected: "temas seleccionados",
    selectedTopics: "Temas seleccionados",
    search: "Buscar temas...",
    noMatches: "No se encontraron temas.",
    remove: "Quitar",
    results: "art\u00edculos mostrados",
    empty: "No se encontraron art\u00edculos sobre este tema.",
  },
  "pt-br": {
    label: "Filtrar por tema",
    all: "Todos os artigos",
    clear: "Limpar tudo",
    selected: "temas selecionados",
    selectedTopics: "Temas selecionados",
    search: "Buscar temas...",
    noMatches: "Nenhum tema encontrado.",
    remove: "Remover",
    results: "artigos exibidos",
    empty: "Nenhum artigo encontrado para este tema.",
  },
}[locale]
---

<section class="portfolio-dark-grid min-h-screen bg-[#0b0b0c] text-white">
  <div class="mx-auto max-w-[90rem] px-5 py-20 lg:px-10 lg:py-28">
    <header
      class="grid gap-10 border-b border-[#c86d61] pb-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-end lg:gap-16 lg:pb-14"
    >
      <div>
        <p class="text-xs font-black tracking-[0.22em] text-[#e17669] uppercase">
          {labels.eyebrow}
        </p>
        <h1 class="display-type mt-7 text-6xl leading-[0.82] sm:text-7xl lg:text-8xl">
          {
            titleLines.map((line, index) => (
              <>
                {line}
                {index < titleLines.length - 1 && <br />}
              </>
            ))
          }
        </h1>
      </div>
      <p class="max-w-xl text-lg leading-relaxed text-white/75">{labels.description}</p>
    </header>
    {
      kind === "work" && (
        <div class="mt-14 grid gap-6">
          {work.map(item => (
            <WorkCard item={item} locale={locale} />
          ))}
        </div>
      )
    }
    {
      kind === "projects" && (
        <div class="mt-14 grid grid-cols-1 gap-8 md:grid-cols-2">
          {projects.map((project, index) => (
            <ProjectCard project={project} eager={index === 0} locale={locale} surface="dark" />
          ))}
        </div>
      )
    }
    {
      kind === "blog" && (
        <>
          <section
            class="blog-tag-filter mt-12 border-y border-white/15 py-5"
            aria-label={blogFilterCopy.label}
          >
            <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
              <div class="flex items-baseline gap-3">
                <p class="text-xs font-black tracking-[0.18em] text-[#e17669] uppercase">
                  {blogFilterCopy.label}
                </p>
                <p class="blog-filter-count text-xs font-bold text-white/45" aria-live="polite" />
              </div>
              <details class="blog-filter-menu group relative w-full sm:w-auto">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 border border-white/25 bg-white/[0.04] px-4 py-2.5 font-mono text-xs font-bold tracking-[0.13em] text-white uppercase transition hover:border-[#9fc7db] hover:text-[#9fc7db] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#9fc7db] sm:min-w-60">
                  <span class="flex items-center gap-2">
                    <Icon name="lucide:tags" class="size-4 text-[#9fc7db]" />
                    <span
                      class="blog-filter-summary"
                      data-all-label={blogFilterCopy.all}
                      data-selected-label={blogFilterCopy.selected}
                    >
                      {blogFilterCopy.all}
                    </span>
                  </span>
                  <Icon
                    name="lucide:chevron-down"
                    class="size-4 text-white/55 transition group-open:rotate-180"
                  />
                </summary>
                <div class="absolute right-0 z-20 mt-2 w-[min(34rem,calc(100vw-2.5rem))] border border-white/20 bg-[#11151b] p-3 shadow-2xl shadow-black/40">
                  <label class="relative block">
                    <Icon
                      name="lucide:search"
                      class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-white/35"
                    />
                    <input
                      type="search"
                      class="blog-filter-search w-full border border-white/15 bg-black/20 py-2.5 pr-3 pl-9 text-sm text-white outline-none placeholder:text-white/35 focus:border-[#9fc7db] focus:ring-1 focus:ring-[#9fc7db]"
                      placeholder={blogFilterCopy.search}
                      aria-label={blogFilterCopy.search}
                    />
                  </label>
                  <div
                    class="blog-filter-selection mt-3 hidden border-y border-white/10 py-2"
                    data-label={blogFilterCopy.selectedTopics}
                    data-remove-label={blogFilterCopy.remove}
                  >
                    <div class="flex items-start gap-3">
                      <p class="mt-1 text-[0.65rem] font-black tracking-[0.13em] text-white/45 uppercase">
                        {blogFilterCopy.selectedTopics}
                      </p>
                      <div class="blog-filter-selected flex flex-wrap gap-1.5" />
                    </div>
                  </div>
                  <div class="blog-filter-options mt-3 max-h-[24rem] space-y-4 overflow-y-auto pr-1 custom-scrollbar">
                    {groupedBlogTags.map(group => (
                      <section class="blog-filter-group" data-tag-group>
                        <p class="mb-1.5 px-2 text-[0.65rem] font-black tracking-[0.15em] text-[#e17669]/80 uppercase">
                          {group.label}
                        </p>
                        <div class="grid grid-cols-2 gap-1 md:grid-cols-3">
                          {group.tags.map(({ tag, count }) => (
                            <label class="blog-filter-option flex min-w-0 cursor-pointer items-center justify-between gap-2 px-2 py-1.5 text-sm text-white/65 transition hover:bg-white/[0.07] hover:text-white">
                              <span class="flex min-w-0 items-center gap-2">
                                <input
                                  type="checkbox"
                                  value={tag}
                                  class="blog-filter-input peer sr-only"
                                />
                                <span class="flex size-4 shrink-0 items-center justify-center border border-white/25 bg-black/20 transition peer-checked:border-[#e17669] peer-checked:bg-[#e17669] peer-checked:[&>svg]:opacity-100">
                                  <Icon
                                    name="lucide:check"
                                    class="size-3 text-white opacity-0 transition peer-checked:opacity-100"
                                  />
                                </span>
                                <span class="truncate">{tag}</span>
                              </span>
                              <span class="text-xs font-bold text-white/25">{count}</span>
                            </label>
                          ))}
                        </div>
                      </section>
                    ))}
                    <p class="blog-filter-no-matches hidden px-2 py-6 text-center text-sm text-white/45">
                      {blogFilterCopy.noMatches}
                    </p>
                  </div>
                  <div class="mt-3 flex border-t border-white/15 pt-3">
                    <button
                      type="button"
                      class="blog-filter-clear border border-white/30 bg-white/[0.07] px-3 py-2 text-[0.65rem] font-black tracking-[0.13em] text-white/80 uppercase transition hover:border-[#e17669] hover:bg-white/[0.12] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#e17669]"
                    >
                      {blogFilterCopy.clear}
                    </button>
                  </div>
                </div>
              </details>
            </div>
          </section>
          <div
            class="blog-post-grid mt-7 grid gap-5 lg:grid-cols-2"
            data-results-label={blogFilterCopy.results}
          >
            {posts.map(post => (
              <div class="blog-post-item h-full" data-tags={(post.tags ?? []).join("|")}>
                <BlogCard post={post} locale={locale} />
              </div>
            ))}
          </div>
          <p class="blog-filter-empty mt-12 hidden text-center text-lg font-semibold text-white/65">
            {blogFilterCopy.empty}
          </p>
          <script>import "@/scripts/blog-tag-filter"</script>
        </>
      )
    }
  </div>
</section>
