---
import BlogCard from "@/components/BlogCard.astro"
import ProjectCard from "@/components/ProjectCard.astro"
import WorkCard from "@/components/WorkCard.astro"
import type { Locale } from "@/lib/i18n"
import { copy } from "@/lib/i18n"
import { getAllBlogPosts, getAllProjects, getAllWorkItems } from "@/lib/content"

interface Props {
  locale: Locale
  kind: "work" | "projects" | "blog"
}

const { locale, kind } = Astro.props
const labels = copy[locale][kind]
const [work, projects, posts] = await Promise.all([
  getAllWorkItems(),
  getAllProjects(),
  getAllBlogPosts(),
])
const titleLines = labels.title.split("\n")
const themes = {
  work: "portfolio-dark-grid min-h-screen bg-[#0b0b0c] text-white",
  projects: "portfolio-grid min-h-screen bg-[#ece8df] text-[#11151b]",
  blog: "min-h-screen bg-[#11151b] text-white",
}
const descriptionColor = kind === "projects" ? "text-[#11151b]/70" : "text-white/70"
---

<section class={themes[kind]}>
  <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
    <header
      class="grid gap-8 border-b-2 border-[#c86d61] pb-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-end"
    >
      <div>
        <p class="text-xs font-black tracking-[0.2em] text-[#c86d61] uppercase">{labels.eyebrow}</p>
        <h1 class="display-type mt-6 text-6xl leading-[0.85] sm:text-8xl">
          {
            titleLines.map((line, index) => (
              <>
                {line}
                {index < titleLines.length - 1 && <br />}
              </>
            ))
          }
        </h1>
      </div>
      <p class={`max-w-xl text-lg leading-relaxed ${descriptionColor}`}>{labels.description}</p>
    </header>
    {
      kind === "work" && (
        <div class="mt-14 grid gap-6">
          {work.map(item => (
            <WorkCard item={item} locale={locale} />
          ))}
        </div>
      )
    }
    {
      kind === "projects" && (
        <div class="mt-14 grid grid-cols-1 gap-8 md:grid-cols-2">
          {projects.map((project, index) => (
            <ProjectCard project={project} eager={index === 0} locale={locale} />
          ))}
        </div>
      )
    }
    {
      kind === "blog" && (
        <div class="mt-14 grid gap-5 lg:grid-cols-2">
          {posts.map(post => (
            <BlogCard post={post} locale={locale} />
          ))}
        </div>
      )
    }
  </div>
</section>
