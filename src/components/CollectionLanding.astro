---
import { Icon } from "astro-icon/components"
import BlogCard from "@/components/BlogCard.astro"
import ProjectCard from "@/components/ProjectCard.astro"
import SectionHeader from "@/components/SectionHeader.astro"
import WorkLog from "@/components/WorkLog.astro"
import { groupBlogTags } from "@/data/blog-tags"
import type { Locale } from "@/lib/i18n"
import { copy } from "@/lib/i18n"
import { getAllBlogPosts, getAllProjects, getAllWorkItems } from "@/lib/content"

interface Props {
  locale: Locale
  kind: "work" | "projects" | "blog"
}

const { locale, kind } = Astro.props
const labels = copy[locale][kind]
const filter = copy[locale].blogFilter
const [work, projects, posts] = await Promise.all([
  getAllWorkItems(),
  getAllProjects(),
  getAllBlogPosts(locale),
])
const blogTags = [...new Map(posts.flatMap(post => post.tags ?? []).map(tag => [tag, 0]))]
  .map(([tag]) => ({
    tag,
    count: posts.filter(post => post.tags?.includes(tag)).length,
  }))
  .sort((a, b) => a.tag.localeCompare(b.tag))
const groupedBlogTags = groupBlogTags(blogTags, locale)
const tilts = ["-0.6deg", "0.5deg", "0.3deg", "-0.4deg"]
---

<section class="mx-auto max-w-6xl px-4 pt-14 pb-10 sm:px-6 lg:pt-20">
  <SectionHeader
    level="h1"
    eyebrow={labels.eyebrow}
    title={labels.title}
    description={labels.description}
  />

  {kind === "work" && (
    <div class="mt-12">
      <WorkLog items={work} locale={locale} detailed />
    </div>
  )}

  {kind === "projects" && (
    <div class="mt-12 grid gap-8 md:grid-cols-2">
      {projects.map((project, index) => (
        <div data-reveal style={`--delay: ${(index % 2) * 0.12}s`}>
          <ProjectCard project={project} eager={index < 2} locale={locale} />
        </div>
      ))}
    </div>
  )}

  {kind === "blog" && (
    <>
      <section
        class="blog-tag-filter mt-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
        aria-label={filter.label}
      >
        <div class="flex items-baseline gap-3 font-mono text-xs">
          <p class="text-accent">
            <span aria-hidden="true">$ grep --tag · </span>
            {filter.label}
          </p>
          <p class="blog-filter-count text-muted" aria-live="polite" />
        </div>
        <details class="blog-filter-menu group relative w-full sm:w-auto">
          <summary class="flex h-10 cursor-pointer list-none items-center justify-between gap-3 rounded-md border border-line bg-sheet px-3.5 font-mono text-xs text-ink transition hover:border-accent sm:min-w-64 [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-2">
              <Icon name="lucide:tags" class="size-4 text-accent" />
              <span
                class="blog-filter-summary"
                data-all-label={filter.all}
                data-selected-one-label={filter.selectedOne}
                data-selected-label={filter.selected}
              >
                {filter.all}
              </span>
            </span>
            <Icon
              name="lucide:chevron-down"
              class="size-4 text-muted transition group-open:rotate-180"
            />
          </summary>
          <div class="sheet absolute right-0 z-20 mt-2 w-[min(34rem,calc(100vw-2rem))] rounded-md p-3">
            <label class="relative block">
              <Icon
                name="lucide:search"
                class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-muted"
              />
              <input
                type="search"
                class="blog-filter-search w-full rounded-md border border-line bg-paper py-2.5 pr-3 pl-9 font-mono text-sm text-ink outline-none placeholder:text-muted focus:border-accent"
                placeholder={filter.search}
                aria-label={filter.search}
              />
            </label>
            <div
              class="blog-filter-selection mt-3 hidden border-y border-dashed border-line py-2"
              data-label={filter.selectedTopics}
              data-remove-label={filter.remove}
            >
              <div class="flex items-start gap-3">
                <p class="mt-1 font-mono text-xs text-muted">{filter.selectedTopics}</p>
                <div class="blog-filter-selected flex flex-wrap gap-1.5" />
              </div>
            </div>
            <div class="blog-filter-options mt-3 max-h-[24rem] space-y-4 overflow-y-auto pr-1">
              {groupedBlogTags.map(group => (
                <section class="blog-filter-group" data-tag-group>
                  <p class="mb-1.5 px-2 font-mono text-xs text-accent">{group.label}</p>
                  <div class="grid grid-cols-2 gap-1 md:grid-cols-3">
                    {group.tags.map(({ tag, count }) => (
                      <label class="blog-filter-option flex min-w-0 cursor-pointer items-center justify-between gap-2 rounded px-2 py-1.5 text-sm text-ink-soft transition hover:bg-accent-soft hover:text-ink">
                        <span class="flex min-w-0 items-center gap-2">
                          <input
                            type="checkbox"
                            value={tag}
                            class="blog-filter-input peer sr-only"
                          />
                          <span class="flex size-4 shrink-0 items-center justify-center rounded-sm border border-line bg-paper transition peer-checked:border-accent peer-checked:bg-accent peer-checked:[&>svg]:opacity-100 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent">
                            <Icon
                              name="lucide:check"
                              class="size-3 text-on-ink opacity-0 transition"
                            />
                          </span>
                          <span class="truncate">{tag}</span>
                        </span>
                        <span class="font-mono text-xs text-muted">{count}</span>
                      </label>
                    ))}
                  </div>
                </section>
              ))}
              <p class="blog-filter-no-matches hidden px-2 py-6 text-center text-sm text-muted">
                {filter.noMatches}
              </p>
            </div>
            <div class="mt-3 flex border-t border-dashed border-line pt-3">
              <button type="button" class="blog-filter-clear btn-line py-1.5 text-xs">
                {filter.clear}
              </button>
            </div>
          </div>
        </details>
      </section>
      <div
        class="blog-post-grid mt-8 grid gap-8 md:grid-cols-2"
        data-result-label={filter.result}
        data-results-label={filter.results}
      >
        {posts.map((post, index) => (
          <div class="blog-post-item h-full" data-tags={(post.tags ?? []).join("|")}>
            <BlogCard post={post} locale={locale} tilt={tilts[index % tilts.length]} />
          </div>
        ))}
      </div>
      <p class="blog-filter-empty hand mt-12 hidden text-center text-2xl text-annot">
        {filter.empty}
      </p>
      <script>
        import "@/scripts/blog-tag-filter"
      </script>
    </>
  )}
</section>
