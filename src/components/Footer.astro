---
import { Icon } from "astro-icon/components"
import { footerConfig } from "@/data/portfolio"
import { copy, getLocaleFromPathname, getLocalizedPath } from "@/lib/i18n"

const locale = getLocaleFromPathname(Astro.url.pathname)
const labels = copy[locale]
const navigation = [
  { key: "home", path: "/" },
  { key: "work", path: "/work" },
  { key: "projects", path: "/projects" },
  { key: "blog", path: "/blog" },
  { key: "byo", path: "/byo" },
] as const
---

<footer
  id="footerPortfolio"
  class="border-t-4 border-[#88c0d0] bg-[#2e3440] px-5 py-12 text-white lg:px-8"
>
  <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-[1.2fr_1fr_1fr]">
    <div>
      <p class="text-sm font-black tracking-[0.16em] uppercase">Daniel Benitez</p>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/60">{labels.footer.description}</p>
    </div>
    <div>
      <p class="text-xs font-black tracking-[0.16em] text-[#8fbcbb] uppercase">
        {labels.footer.explore}
      </p>
      <div class="mt-4 flex flex-col gap-2">
        {navigation.map(item => (
          <a
            href={getLocalizedPath(item.path, locale)}
            class="text-sm font-bold text-white/75 hover:text-white"
          >
            {labels.nav[item.key]}
          </a>
        ))}
      </div>
    </div>
    <div>
      <p class="text-xs font-black tracking-[0.16em] text-[#8fbcbb] uppercase">
        {labels.footer.findMe}
      </p>
      <div class="mt-4 flex gap-3">
        {footerConfig.socialLinks.map(link => (
          <a
            href={link.href}
            aria-label={link.label}
            class="grid size-10 place-items-center border border-white/25 text-white transition hover:border-[#88c0d0] hover:bg-[#88c0d0] hover:text-[#2e3440]"
          >
            <Icon name={link.icon} class="size-4" />
          </a>
        ))}
      </div>
    </div>
  </div>
  <p class="mx-auto mt-12 max-w-7xl border-t border-white/15 pt-5 text-xs font-semibold tracking-wide text-white/45">
    © {new Date().getFullYear()}
    {footerConfig.copyrightName}. All rights reserved.
  </p>
</footer>
