---
import { Icon } from "astro-icon/components"
import { footerConfig, homeIntroConfig } from "@/data/portfolio"
import { copy, getLocaleFromPathname, getLocalizedPath } from "@/lib/i18n"

const locale = getLocaleFromPathname(Astro.url.pathname)
const labels = copy[locale]
const navigation = [
  { key: "home", path: "/" },
  { key: "work", path: "/work" },
  { key: "projects", path: "/projects" },
  { key: "blog", path: "/blog" },
  { key: "byo", path: "/byo" },
] as const
const copyright = `© ${new Date().getFullYear()} ${footerConfig.copyrightName}. ${labels.ui.rights}`
---

<footer id="footerPortfolio" class="mt-24 border-t-[1.5px] border-dashed border-line bg-paper/90">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="flex items-baseline gap-1">
        <span class="font-mono text-sm text-accent">~/</span>
        <span class="hand text-3xl text-ink">{homeIntroConfig.shortName.toLowerCase()}</span>
      </p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted">{labels.footer.description}</p>
    </div>
    <div>
      <p class="eyebrow">{labels.footer.explore}</p>
      <ul class="mt-4 grid gap-1.5 font-mono text-sm">
        {navigation.map(item => (
          <li>
            <a
              href={getLocalizedPath(item.path, locale)}
              class="text-ink-soft underline-offset-4 transition hover:text-accent hover:underline hover:decoration-wavy"
            >
              <span class="text-accent" aria-hidden="true">
                ./
              </span>
              {labels.nav[item.key].toLowerCase()}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <p class="eyebrow">{labels.footer.findMe}</p>
      <div class="mt-4 flex gap-2">
        {footerConfig.socialLinks.map(link => (
          <a
            href={link.href}
            aria-label={link.label}
            rel="me noopener noreferrer"
            class="grid size-10 place-items-center rounded-md border border-line bg-sheet text-ink transition hover:-translate-y-0.5 hover:border-accent hover:text-accent"
          >
            <Icon name={link.icon} class="size-4" />
          </a>
        ))}
      </div>
    </div>
  </div>
  <div class="border-t-[1.5px] border-dashed border-line">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-1 px-4 py-3 font-mono text-xs text-muted sm:px-6">
      <p>
        <span aria-hidden="true">⎇ main · </span>
        {copyright}
      </p>
      <p class="text-accent">
        <span aria-hidden="true">✓ </span>
        {labels.ui.buildPassing}
      </p>
    </div>
  </div>
</footer>
