---
import { Icon } from "astro-icon/components"
import LanguageFlag from "@/components/LanguageFlag.astro"
import { homeIntroConfig } from "@/data/portfolio"
import {
  copy,
  getLocaleFromPathname,
  getLocaleSwitchPath,
  getLocalizedPath,
  localeOptions,
} from "@/lib/i18n"

interface Props {
  pathname: string
  isBlogPost?: boolean
}

const { pathname, isBlogPost = false } = Astro.props
const locale = getLocaleFromPathname(pathname)
const labels = copy[locale]
const crumbs = pathname.split("/").filter(Boolean)
const initials = homeIntroConfig.name
  .split(" ")
  .map(part => part[0])
  .join("")
  .toUpperCase()
const navigation = [
  { key: "work", path: "/work" },
  { key: "projects", path: "/projects" },
  { key: "blog", path: "/blog" },
] as const
const activePath = `/${crumbs.filter(crumb => !localeOptions.some(item => item.code === crumb))[0] ?? ""}`
const activeLocale = localeOptions.find(option => option.code === locale) ?? localeOptions[0]
---

<header
  id="headerPortfolio"
  class="sticky top-0 z-50 border-b-4 border-[#c86d61] bg-[#0b0b0c] text-white"
>
  <div class="mx-auto flex min-h-20 max-w-7xl items-center justify-between gap-6 px-5 py-4 lg:px-8">
    <a
      href={getLocalizedPath("/", locale)}
      class="flex items-center gap-3"
      aria-label="Daniel Benitez home"
    >
      <span
        class="grid size-10 place-items-center border-2 border-white text-sm font-black tracking-tighter"
        >{initials}</span
      >
      <span class="text-xs font-black leading-[0.85] tracking-[0.16em] uppercase sm:text-sm"
        >Daniel<br />Benitez</span
      >
    </a>
    <nav class="hidden items-center gap-7 md:flex" aria-label="Main navigation">
      {
        navigation.map(item => (
          <a
            href={getLocalizedPath(item.path, locale)}
            class:list={[
              "relative py-2 text-xs font-black tracking-[0.14em] uppercase transition-colors after:absolute after:inset-x-0 after:-bottom-1 after:h-0.5 after:bg-[#c86d61] after:transition-transform",
              activePath === item.path
                ? "text-white after:scale-x-100"
                : "text-white/60 hover:text-white after:scale-x-0 hover:after:scale-x-100",
            ]}
          >
            {labels.nav[item.key]}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-3">
      <details class="group relative hidden md:block">
        <summary
          class="flex cursor-pointer list-none items-center gap-2 border border-[#c86d61] bg-[#171719] px-3 py-2 text-xs font-black text-white transition hover:bg-[#242426] [&::-webkit-details-marker]:hidden"
        >
          <LanguageFlag locale={activeLocale.code} />
          <span>{activeLocale.label}</span>
          <Icon name="lucide:chevron-down" class="size-3 transition group-open:rotate-180" />
        </summary>
        <div
          class="absolute right-0 mt-2 w-56 overflow-hidden border border-[#c86d61] bg-[#171719] p-1 shadow-2xl"
        >
          {
            localeOptions.map(option => (
              <a
                href={getLocaleSwitchPath(pathname, option.code)}
                data-locale-option={option.code}
                aria-current={option.code === locale ? "true" : undefined}
                class:list={[
                  "flex items-center gap-3 px-3 py-3 text-sm font-bold transition",
                  option.code === locale
                    ? "bg-[#c86d61] text-white"
                    : "text-white/85 hover:bg-white/10 hover:text-white",
                ]}
              >
                <LanguageFlag locale={option.code} />
                {option.label}
              </a>
            ))
          }
        </div>
      </details>
      <button
        id="mobile-menu-toggle"
        class="inline-flex size-10 items-center justify-center border border-white/30 text-white transition hover:border-[#c86d61] md:hidden"
        aria-label="Toggle navigation"
        aria-expanded="false"
      >
        <Icon name="lucide:menu" class="size-5" />
      </button>
    </div>
  </div>
  <nav
    id="mobile-menu"
    class="hidden border-t border-white/15 px-5 py-4 md:hidden"
    aria-label="Mobile navigation"
  >
    <div class="flex flex-col gap-1">
      <a
        href={getLocalizedPath("/", locale)}
        class:list={[
          "border-l-2 px-3 py-2 text-xs font-black tracking-[0.14em] uppercase",
          activePath === "/" ? "border-[#c86d61] text-white" : "border-transparent text-white/65",
        ]}>{labels.nav.home}</a
      >
      {
        navigation.map(item => (
          <a
            href={getLocalizedPath(item.path, locale)}
            class:list={[
              "border-l-2 px-3 py-2 text-xs font-black tracking-[0.14em] uppercase",
              activePath === item.path
                ? "border-[#c86d61] text-white"
                : "border-transparent text-white/65",
            ]}
          >
            {labels.nav[item.key]}
          </a>
        ))
      }
    </div>
    <div class="mt-4 grid grid-cols-3 gap-2 border-t border-white/15 pt-4">
      {
        localeOptions.map(option => (
          <a
            href={getLocaleSwitchPath(pathname, option.code)}
            data-locale-option={option.code}
            class:list={[
              "border px-2 py-2 text-center text-xs font-black",
              option.code === locale
                ? "border-[#c86d61] bg-[#c86d61]"
                : "border-white/25 text-white/70",
            ]}
          >
            <>
              <LanguageFlag locale={option.code} />
              <span class="sr-only">{option.label}</span>
            </>
          </a>
        ))
      }
    </div>
  </nav>
  {
    isBlogPost && (
      <div
        id="scroll-progress"
        class="h-1 origin-left scale-x-0 bg-[#c86d61]"
        aria-label="Scroll progress"
      />
    )
  }
</header>
