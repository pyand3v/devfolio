---
import { Icon } from "astro-icon/components"
import LanguageFlag from "@/components/LanguageFlag.astro"
import { homeIntroConfig } from "@/data/portfolio"
import {
  copy,
  getLocaleFromPathname,
  getLocaleSwitchPath,
  getLocalizedPath,
  localeOptions,
} from "@/lib/i18n"

interface Props {
  pathname: string
  isBlogPost?: boolean
}

const { pathname, isBlogPost = false } = Astro.props
const locale = getLocaleFromPathname(pathname)
const labels = copy[locale]
const crumbs = pathname.split("/").filter(Boolean)
const navigation = [
  { key: "work", path: "/work" },
  { key: "projects", path: "/projects" },
  { key: "blog", path: "/blog" },
  { key: "byo", path: "/byo" },
] as const
const activePath = `/${crumbs.filter(crumb => !localeOptions.some(item => item.code === crumb))[0] ?? ""}`
const activeLocale = localeOptions.find(option => option.code === locale) ?? localeOptions[0]
const handle = homeIntroConfig.shortName.toLowerCase()
---

<header
  id="headerPortfolio"
  class="sticky top-0 z-50 border-b-[1.5px] border-dashed border-line bg-paper/85 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-4 sm:px-6">
    <a
      href={getLocalizedPath("/", locale)}
      class="group flex items-baseline gap-1"
      aria-label={`${homeIntroConfig.name}, ${labels.nav.home}`}
    >
      <span class="font-mono text-sm text-accent transition group-hover:-translate-x-0.5">~/</span>
      <span class="hand text-[1.75rem] leading-none text-ink">{handle}</span>
    </a>
    <nav class="hidden items-center gap-7 md:flex" aria-label={labels.a11y.mainNav}>
      {navigation.map(item => (
        <a
          href={getLocalizedPath(item.path, locale)}
          aria-current={activePath === item.path ? "page" : undefined}
          class:list={[
            "text-[0.9375rem] underline-offset-[7px] transition-colors",
            activePath === item.path
              ? "text-ink underline decoration-accent decoration-wavy decoration-[1.5px]"
              : "text-muted hover:text-ink",
          ]}
        >
          {labels.nav[item.key]}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      {isBlogPost && (
        <p
          id="scroll-progress-label"
          class="mr-2 hidden font-mono text-xs whitespace-pre text-accent lg:block"
          aria-hidden="true"
        >
          [----------] 0%
        </p>
      )}
      <a
        href={getLocalizedPath("/search", locale)}
        data-search-link
        aria-label={labels.nav.search}
        aria-current={activePath === "/search" ? "page" : undefined}
        aria-keyshortcuts="Control+K"
        class="hidden h-9 items-center gap-2 rounded-md border border-line bg-sheet px-2.5 font-mono text-xs text-muted transition hover:border-accent hover:text-accent md:inline-flex"
      >
        <Icon name="lucide:search" class="size-3.5" />
        <kbd class="font-mono">Ctrl K</kbd>
      </a>
      <details class="group relative hidden md:block">
        <summary class="flex h-9 cursor-pointer list-none items-center gap-2 rounded-md border border-line bg-sheet px-2.5 font-mono text-xs text-ink transition hover:border-accent [&::-webkit-details-marker]:hidden">
          <LanguageFlag locale={activeLocale.code} />
          <span class="uppercase" aria-hidden="true">
            {activeLocale.code}
          </span>
          <span class="sr-only">
            {labels.ui.language}: {activeLocale.label}
          </span>
          <Icon name="lucide:chevron-down" class="size-3 transition group-open:rotate-180" />
        </summary>
        <div class="sheet absolute right-0 mt-2 w-56 rounded-md p-1">
          {localeOptions.map(option => (
            <a
              href={getLocaleSwitchPath(pathname, option.code)}
              data-locale-option={option.code}
              lang={option.code}
              aria-current={option.code === locale ? "true" : undefined}
              class:list={[
                "flex items-center gap-3 rounded px-3 py-2.5 text-sm transition",
                option.code === locale
                  ? "bg-accent-soft text-accent-ink"
                  : "text-ink-soft hover:bg-accent-soft/60 hover:text-ink",
              ]}
            >
              <LanguageFlag locale={option.code} />
              {option.label}
            </a>
          ))}
        </div>
      </details>
      <button
        id="theme-toggle"
        type="button"
        class="inline-flex size-9 items-center justify-center rounded-md border border-line bg-sheet text-ink transition hover:border-accent hover:text-accent"
        aria-label={labels.ui.themeToDark}
        data-label-dark={labels.ui.themeToDark}
        data-label-light={labels.ui.themeToLight}
      >
        <Icon name="lucide:moon" class="size-4 dark:hidden" />
        <Icon name="lucide:sun" class="hidden size-4 dark:block" />
      </button>
      <button
        id="mobile-menu-toggle"
        type="button"
        class="inline-flex size-9 items-center justify-center rounded-md border border-line bg-sheet text-ink transition hover:border-accent md:hidden"
        aria-label={labels.a11y.toggleNav}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="lucide:menu" class="size-5" />
      </button>
    </div>
  </div>
  <nav
    id="mobile-menu"
    class="hidden border-t-[1.5px] border-dashed border-line px-4 py-4 md:hidden"
    aria-label={labels.a11y.mobileNav}
  >
    <div class="flex flex-col gap-1 font-mono text-sm">
      {[
        { key: "home", path: "/" } as const,
        ...navigation,
        { key: "search", path: "/search" } as const,
      ].map(item => (
        <a
          href={getLocalizedPath(item.path, locale)}
          aria-current={activePath === item.path ? "page" : undefined}
          class:list={[
            "rounded px-3 py-2",
            activePath === item.path ? "bg-accent-soft text-accent-ink" : "text-ink-soft",
          ]}
        >
          <span class="text-accent" aria-hidden="true">
            ./
          </span>
          {labels.nav[item.key].toLowerCase()}
        </a>
      ))}
    </div>
    <div class="mt-4 grid grid-cols-3 gap-2 border-t-[1.5px] border-dashed border-line pt-4">
      {localeOptions.map(option => (
        <a
          href={getLocaleSwitchPath(pathname, option.code)}
          data-locale-option={option.code}
          aria-current={option.code === locale ? "true" : undefined}
          class:list={[
            "flex items-center justify-center gap-2 rounded-md border px-2 py-2 font-mono text-xs uppercase",
            option.code === locale
              ? "border-accent bg-accent-soft text-accent-ink"
              : "border-line bg-sheet text-ink-soft",
          ]}
        >
          <LanguageFlag locale={option.code} />
          <span aria-hidden="true">{option.code}</span>
          <span class="sr-only">{option.label}</span>
        </a>
      ))}
    </div>
  </nav>
  {isBlogPost && (
    <div
      id="scroll-progress"
      class="absolute inset-x-0 -bottom-[1.5px] h-[3px] origin-left scale-x-0 bg-accent"
      aria-hidden="true"
    />
  )}
</header>
