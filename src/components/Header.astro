---
import { Icon } from "astro-icon/components"
import LanguageFlag from "@/components/LanguageFlag.astro"
import { homeIntroConfig } from "@/data/portfolio"
import {
  copy,
  getLocaleFromPathname,
  getLocaleSwitchPath,
  getLocalizedPath,
  localeOptions,
} from "@/lib/i18n"

interface Props {
  pathname: string
  isBlogPost?: boolean
}

const { pathname, isBlogPost = false } = Astro.props
const locale = getLocaleFromPathname(pathname)
const labels = copy[locale]
const crumbs = pathname.split("/").filter(Boolean)
const initials = homeIntroConfig.name
  .split(" ")
  .map(part => part[0])
  .join("")
  .toUpperCase()
const navigation = [
  { key: "work", path: "/work" },
  { key: "projects", path: "/projects" },
  { key: "blog", path: "/blog" },
  { key: "byo", path: "/byo" },
] as const
const activePath = `/${crumbs.filter(crumb => !localeOptions.some(item => item.code === crumb))[0] ?? ""}`
const activeLocale = localeOptions.find(option => option.code === locale) ?? localeOptions[0]
---

<header
  id="headerPortfolio"
  class="sticky top-0 z-50 border-b-4 border-[#88c0d0] bg-[#2e3440] text-[#eceff4]"
>
  <div class="mx-auto flex min-h-24 max-w-7xl items-center justify-between gap-8 px-5 py-5 lg:px-8">
    <a
      href={getLocalizedPath("/", locale)}
      class="flex items-center gap-3"
      aria-label="Daniel Benitez home"
    >
      <span class="grid size-10 place-items-center border-2 border-[#88c0d0] text-sm font-black tracking-tighter">
        {initials}
      </span>
      <span class="text-sm font-black leading-[0.85] tracking-[0.16em] uppercase sm:text-base">
        Daniel
        <br />
        Benitez
      </span>
    </a>
    <nav class="hidden items-center gap-9 md:flex" aria-label="Main navigation">
      {navigation.map(item => (
        <a
          href={getLocalizedPath(item.path, locale)}
          class:list={[
            "relative py-3 text-sm font-black tracking-[0.12em] uppercase transition-colors after:absolute after:inset-x-0 after:-bottom-1 after:h-0.5 after:bg-[#88c0d0] after:transition-transform",
            activePath === item.path
              ? "text-white after:scale-x-100"
              : "text-white/60 hover:text-white after:scale-x-0 hover:after:scale-x-100",
          ]}
        >
          {labels.nav[item.key]}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <details class="group relative hidden md:block">
        <summary class="flex cursor-pointer list-none items-center gap-2 border border-[#4c566a] bg-[#3b4252] px-3.5 py-2.5 text-sm font-black text-[#eceff4] transition hover:border-[#88c0d0] hover:bg-[#434c5e] [&::-webkit-details-marker]:hidden">
          <LanguageFlag locale={activeLocale.code} />
          <span>{activeLocale.label}</span>
          <Icon name="lucide:chevron-down" class="size-3 transition group-open:rotate-180" />
        </summary>
        <div class="absolute right-0 mt-2 w-56 overflow-hidden border border-[#4c566a] bg-[#3b4252] p-1 shadow-2xl">
          {localeOptions.map(option => (
            <a
              href={getLocaleSwitchPath(pathname, option.code)}
              data-locale-option={option.code}
              aria-current={option.code === locale ? "true" : undefined}
              class:list={[
                "flex items-center gap-3 px-3 py-3 text-sm font-bold transition",
                option.code === locale
                  ? "bg-[#88c0d0] text-[#2e3440]"
                  : "text-white/85 hover:bg-white/10 hover:text-white",
              ]}
            >
              <LanguageFlag locale={option.code} />
              {option.label}
            </a>
          ))}
        </div>
      </details>
      <button
        id="mobile-menu-toggle"
        class="inline-flex size-11 items-center justify-center border border-white/30 text-white transition hover:border-[#88c0d0] md:hidden"
        aria-label="Toggle navigation"
        aria-expanded="false"
      >
        <Icon name="lucide:menu" class="size-5" />
      </button>
    </div>
  </div>
  <nav
    id="mobile-menu"
    class="hidden border-t border-white/15 px-5 py-4 md:hidden"
    aria-label="Mobile navigation"
  >
    <div class="flex flex-col gap-1">
      <a
        href={getLocalizedPath("/", locale)}
        class:list={[
          "border-l-2 px-3 py-2 text-xs font-black tracking-[0.14em] uppercase",
          activePath === "/" ? "border-[#88c0d0] text-white" : "border-transparent text-white/65",
        ]}
      >
        {labels.nav.home}
      </a>
      {navigation.map(item => (
        <a
          href={getLocalizedPath(item.path, locale)}
          class:list={[
            "border-l-2 px-3 py-2 text-xs font-black tracking-[0.14em] uppercase",
            activePath === item.path
              ? "border-[#88c0d0] text-white"
              : "border-transparent text-white/65",
          ]}
        >
          {labels.nav[item.key]}
        </a>
      ))}
    </div>
    <div class="mt-4 grid grid-cols-3 gap-2 border-t border-white/15 pt-4">
      {localeOptions.map(option => (
        <a
          href={getLocaleSwitchPath(pathname, option.code)}
          data-locale-option={option.code}
          class:list={[
            "border px-2 py-2 text-center text-xs font-black",
            option.code === locale
              ? "border-[#88c0d0] bg-[#88c0d0] text-[#2e3440]"
              : "border-white/25 text-white/70",
          ]}
        >
          <>
            <LanguageFlag locale={option.code} />
            <span class="sr-only">{option.label}</span>
          </>
        </a>
      ))}
    </div>
  </nav>
  {isBlogPost && (
    <div
      id="scroll-progress"
      class="h-1 origin-left scale-x-0 bg-[#88c0d0]"
      aria-label="Scroll progress"
    />
  )}
</header>
