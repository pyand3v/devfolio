---
import { Icon } from "astro-icon/components"
import BlogCard from "@/components/BlogCard.astro"
import ByoPathCard from "@/components/ByoPathCard.astro"
import ProjectCard from "@/components/ProjectCard.astro"
import SectionHeader from "@/components/SectionHeader.astro"
import Terminal from "@/components/Terminal.astro"
import TitleLines from "@/components/TitleLines.astro"
import WorkLog from "@/components/WorkLog.astro"
import type { Locale } from "@/lib/i18n"
import { copy, getLocalizedPath } from "@/lib/i18n"
import { homeIntroConfig } from "@/data/portfolio"
import { getAllBlogPosts, getAllByoProjects, getAllProjects, getAllWorkItems } from "@/lib/content"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const labels = copy[locale].home
const ui = copy[locale].ui
const nav = copy[locale].nav
const [blog, work, projects, paths] = await Promise.all([
  getAllBlogPosts(locale),
  getAllWorkItems(),
  getAllProjects(),
  getAllByoProjects(locale),
])
const whoami = homeIntroConfig.name.toLowerCase()
const sections = (["work", "projects", "blog", "byo"] as const).map(key => ({
  label: `${nav[key].toLowerCase()}/`,
  href: getLocalizedPath(`/${key}`, locale),
}))
const noteTilts = ["-1.2deg", "0.8deg", "-0.5deg"]
---

<section class="mx-auto max-w-6xl px-4 pt-14 pb-20 sm:px-6 lg:pt-20 lg:pb-28">
  <div class="grid items-center gap-14 lg:grid-cols-[1.15fr_0.85fr]">
    <div>
      <p class="eyebrow">FIG. 01 · {labels.eyebrow}</p>
      <h1 class="display mt-5 text-5xl text-ink sm:text-6xl lg:text-7xl">
        <TitleLines text={labels.title} underline />
      </h1>
      <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-soft">{labels.headline}</p>
      <p class="hand mt-5 max-w-lg text-2xl text-annot">“{labels.slogan}”</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={getLocalizedPath("/work", locale)} class="btn-ink">
          {labels.primary}
          <Icon name="lucide:arrow-right" class="size-4" />
        </a>
        <a href={getLocalizedPath("/blog", locale)} class="btn-line">
          <span class="text-accent" aria-hidden="true">
            $
          </span>
          {labels.readBlog}
        </a>
        <span class="hand hidden text-xl text-annot sm:inline" aria-hidden="true">
          ← {ui.startHere}
        </span>
      </div>
    </div>
    <div class="relative mx-auto w-full max-w-md lg:max-w-none">
      <Terminal title="~/daniel — zsh" tilt="1.2deg">
        <p>
          <span class="text-code-prompt">$</span> whoami
        </p>
        <p class="typed text-code-cyan" style={`--chars: ${whoami.length}; --delay: 0.5s`}>
          {whoami}
        </p>
        <p class="typed" style="--chars: 17; --delay: 1.4s">
          <span class="text-code-prompt">$</span> cat focus.txt
        </p>
        <p
          class="typed text-code-muted"
          style={`--chars: ${labels.availability.length}; --delay: 2.2s`}
        >
          {labels.availability}
        </p>
        <p class="typed" style="--chars: 6; --delay: 3.6s">
          <span class="text-code-prompt">$</span> ls ~/
        </p>
        <p class="flex flex-wrap gap-x-4" data-reveal style="--delay: 4s">
          {sections.map(section => (
            <a href={section.href} class="text-[#79c0ff] underline-offset-4 hover:underline">
              {section.label}
            </a>
          ))}
        </p>
        <p>
          <span class="text-code-prompt">$</span> <span class="cursor" aria-hidden="true"></span>
        </p>
      </Terminal>
      <p
        class="hand absolute -bottom-10 right-2 rotate-[-4deg] text-xl text-annot"
        aria-hidden="true"
      >
        ↑ {ui.alwaysLearning}
      </p>
    </div>
  </div>
</section>

{work.length > 0 && (
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <SectionHeader
      eyebrow={`02 · ${labels.featuredLabel}`}
      title={labels.featuredTitle}
      href={getLocalizedPath("/work", locale)}
      linkLabel={labels.story}
    />
    <div class="mt-10">
      <WorkLog items={work.slice(0, homeIntroConfig.workItemsToShow)} locale={locale} />
    </div>
  </section>
)}

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <SectionHeader
    eyebrow={`03 · ${labels.projectsLabel}`}
    title={labels.projectsTitle}
    href={getLocalizedPath("/projects", locale)}
    linkLabel={labels.allProjects}
  />
  <div class="mt-10 grid gap-8 md:grid-cols-2">
    {projects.slice(0, homeIntroConfig.projectsToShow).map((project, index) => (
      <div data-reveal style={`--delay: ${(index % 2) * 0.12}s`}>
        <ProjectCard project={project} locale={locale} />
      </div>
    ))}
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <SectionHeader
    eyebrow={`04 · ${labels.notesLabel}`}
    title={labels.notesTitle}
    href={getLocalizedPath("/blog", locale)}
    linkLabel={labels.readBlog}
  />
  <div class="mt-12 grid gap-8 md:grid-cols-3">
    {blog.slice(0, homeIntroConfig.blogPostsToShow).map((post, index) => (
      <div data-reveal style={`--delay: ${index * 0.12}s`}>
        <BlogCard post={post} locale={locale} variant="note" tilt={noteTilts[index % 3]} />
      </div>
    ))}
  </div>
</section>

{paths.length > 0 && (
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <SectionHeader
      eyebrow={`05 · ${labels.pathsLabel}`}
      title={labels.pathsTitle}
      href={getLocalizedPath("/byo", locale)}
      linkLabel={copy[locale].byo.allPaths}
    />
    <div class="mt-10 grid gap-8 md:grid-cols-3">
      {paths.map((bundle, index) => (
        <ByoPathCard bundle={bundle} index={index} locale={locale} />
      ))}
    </div>
  </section>
)}
