---
import { Icon } from "astro-icon/components"
import type { Project } from "@/lib/content"
import type { Locale } from "@/lib/i18n"
import TechBadge from "@/components/TechBadge.astro"
import { calculateDuration, formatDateRange } from "@/lib/utils"
interface Props {
  project: Project
  eager?: boolean
  locale?: Locale
}
const { project, eager = false, locale = "en" } = Astro.props
const visibleTech = project.techStack.slice(0, 5)
const more = project.techStack.length - visibleTech.length
const labels = {
  en: { type: "Project", action: "View project" },
  es: { type: "Proyecto", action: "Ver proyecto" },
  "pt-br": { type: "Projeto", action: "Ver projeto" },
}[locale]
---

<a href={`/projects/${project.slug}`} class="group block h-full">
  <article
    class="flex h-full flex-col overflow-hidden border-2 border-[#11151b] bg-[#f7f4ed] shadow-[6px_6px_0_#c86d61] transition duration-200 hover:-translate-y-1 hover:shadow-[10px_10px_0_#c86d61]"
  >
    <div class="relative h-56 overflow-hidden border-b-2 border-[#11151b] bg-[#11151b]">
      <img
        src={project.image}
        alt={project.title}
        class="size-full object-cover transition duration-500 group-hover:scale-105 group-hover:opacity-80"
        loading={eager ? "eager" : "lazy"}
      />
      <span
        class="absolute right-4 top-4 bg-[#c86d61] px-2 py-1 text-[0.65rem] font-black tracking-[0.14em] text-white uppercase"
        >{labels.type}</span
      >
    </div>
    <div class="flex flex-1 flex-col p-6">
      <p class="text-xs font-black tracking-[0.14em] text-[#a95047] uppercase">
        {formatDateRange(project.startDate, project.endDate)} · {
          calculateDuration(project.startDate, project.endDate)
        }
      </p>
      <h3 class="mt-4 text-3xl font-bold tracking-tight text-[#11151b]">{project.title}</h3>
      <p class="mt-3 grow leading-relaxed text-[#11151b]/70">{project.description}</p>
      <div class="mt-6 flex flex-wrap gap-2">
        {visibleTech.map(name => <TechBadge name={name} small />)}
        {
          more > 0 && (
            <span class="border border-[#11151b]/35 px-2 py-0.5 text-xs font-bold text-[#11151b]/70">
              + {more}
            </span>
          )
        }
      </div>
      <span
        class="mt-6 inline-flex items-center gap-2 text-xs font-black tracking-[0.14em] text-[#11151b] uppercase"
        >{labels.action}
        <Icon
          name="lucide:arrow-up-right"
          class="size-4 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        /></span
      >
    </div>
  </article>
</a>
