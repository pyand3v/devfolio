---
import { Icon } from "astro-icon/components"
import type { Project } from "@/lib/content"
import { copy, type Locale } from "@/lib/i18n"
import TechBadge from "@/components/TechBadge.astro"
import { calculateDuration, formatDateRange } from "@/lib/utils"

// A project as an app window drawn in ink; hovering it runs a little build
interface Props {
  project: Project
  eager?: boolean
  locale?: Locale
}

const { project, eager = false, locale = "en" } = Astro.props
const labels = copy[locale].cards
const visibleTech = project.techStack.slice(0, 4)
const more = project.techStack.length - visibleTech.length
const href = `/projects/${project.slug}`
---

<article class="window group relative flex h-full flex-col">
  <div class="window-bar">
    <span class="dot" aria-hidden="true"></span>
    <span class="dot" aria-hidden="true"></span>
    <span class="ml-1 truncate">projects/{project.slug}</span>
    <span class="ml-auto hidden text-accent sm:inline">{labels.project}</span>
  </div>
  <div class="relative aspect-[16/9] overflow-hidden border-b-[1.5px] border-ink bg-grid">
    <img
      src={project.image}
      alt=""
      class="size-full object-cover transition duration-500 group-hover:scale-[1.04]"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
    />
  </div>
  <div class="flex flex-1 flex-col p-5">
    <p class="font-mono text-xs text-accent">
      {formatDateRange(project.startDate, project.endDate)} ·{" "}
      {calculateDuration(project.startDate, project.endDate)}
    </p>
    <h3 class="display mt-2 text-2xl text-ink">
      <a href={href} class="after:absolute after:inset-0 after:content-['']">
        {project.title}
      </a>
    </h3>
    <p class="mt-2 grow leading-relaxed text-ink-soft">{project.description}</p>
    <div class="mt-4 flex flex-wrap gap-1.5">
      {visibleTech.map(name => (
        <TechBadge name={name} />
      ))}
      {more > 0 && <TechBadge name={`+${more}`} />}
    </div>
    <div class="mt-5 flex items-center gap-3 font-mono text-xs text-muted" aria-hidden="true">
      <span>npm run build</span>
      <span class="build-bar grow">
        <span></span>
      </span>
      <Icon
        name="lucide:arrow-up-right"
        class="size-4 text-accent transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
      />
    </div>
  </div>
</article>
