---
interface Image {
  src: string
  alt: string
}
interface Props {
  images: Image[]
}
const { images } = Astro.props
---

{images.length > 0 && (
  <section class="project-gallery my-8" data-gallery>
    <div class="relative overflow-hidden border border-white/20 bg-black/30">
      <div class="gallery-track flex transition-transform duration-300">
        {images.map(image => (
          <img
            src={image.src}
            alt={image.alt}
            class="h-80 min-w-full object-contain"
            loading="lazy"
          />
        ))}
      </div>
      {images.length > 1 && (
        <>
          <button
            type="button"
            class="gallery-prev absolute left-3 top-1/2 -translate-y-1/2 border border-white/30 bg-black/60 p-2 text-white transition hover:border-[#88c0d0] hover:bg-black/80"
            aria-label="Previous image"
          >
            ←
          </button>
          <button
            type="button"
            class="gallery-next absolute right-3 top-1/2 -translate-y-1/2 border border-white/30 bg-black/60 p-2 text-white transition hover:border-[#88c0d0] hover:bg-black/80"
            aria-label="Next image"
          >
            →
          </button>
        </>
      )}
    </div>
    {images.length > 1 && (
      <div class="mt-3 flex justify-center">
        {images.map((_, index) => (
          <button
            type="button"
            class="gallery-dot grid size-6 place-items-center"
            data-index={index}
            aria-label={`Show image ${index + 1}`}
            aria-current={index === 0 ? "true" : undefined}
          >
            <span
              class:list={[
                "size-2.5 border border-white/40",
                index === 0 ? "bg-[#88c0d0]" : "bg-white/25",
              ]}
            />
          </button>
        ))}
      </div>
    )}
  </section>
)}
<script>
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach(gallery => {
    const track = gallery.querySelector<HTMLElement>(".gallery-track")
    const dots = [...gallery.querySelectorAll<HTMLButtonElement>(".gallery-dot")]
    let active = 0
    const show = (index: number) => {
      active = (index + dots.length) % dots.length
      if (track) track.style.transform = `translateX(-${active * 100}%)`
      dots.forEach((dot, i) => {
        dot.firstElementChild?.classList.toggle("bg-[#88c0d0]", i === active)
        dot.firstElementChild?.classList.toggle("bg-white/25", i !== active)
        if (i === active) dot.setAttribute("aria-current", "true")
        else dot.removeAttribute("aria-current")
      })
    }
    gallery.querySelector(".gallery-prev")?.addEventListener("click", () => show(active - 1))
    gallery.querySelector(".gallery-next")?.addEventListener("click", () => show(active + 1))
    dots.forEach((dot, index) => dot.addEventListener("click", () => show(index)))
  })
</script>
