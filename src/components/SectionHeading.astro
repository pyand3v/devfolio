---
import { Icon } from "astro-icon/components"
interface Props {
  title: string
  href: string
  showLink?: boolean
}
const { title, href, showLink = true } = Astro.props
---

<div class="mb-4 flex items-center justify-between gap-4">
  <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">{title}</h2>{
    showLink && (
      <a
        href={href}
        class="group flex items-center gap-1 text-sm font-semibold text-accent-600 transition-all hover:gap-2 dark:text-accent-400"
      >
        View all <Icon name="lucide:arrow-right" class="size-4" />
      </a>
    )
  }
</div>
