---
interface Props {
  name: string
  small?: boolean
  surface?: "light" | "dark"
}
const { name, small = false, surface = "light" } = Astro.props
---

<span
  class:list={[
    "inline-flex items-center border bg-transparent font-mono text-xs font-bold",
    surface === "dark" ? "border-white/35 text-white/75" : "border-[#3b4252]/35 text-[#3b4252]",
    small ? "px-2 py-0.5 text-xs" : "px-3 py-1 text-sm",
  ]}>{name}</span
>
