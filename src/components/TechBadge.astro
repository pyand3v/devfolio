---
interface Props {
  name: string
  large?: boolean
}
const { name, large = false } = Astro.props
---

<span
  class:list={[
    "inline-flex items-center rounded border border-line bg-paper font-mono text-ink-soft",
    large ? "px-2.5 py-1 text-sm" : "px-1.5 py-0.5 text-xs",
  ]}
>
  {name}
</span>
