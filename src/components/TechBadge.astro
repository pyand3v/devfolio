---
interface Props {
  name: string
  small?: boolean
}
const { name, small = false } = Astro.props
---

<span
  class:list={[
    "inline-flex items-center rounded-full bg-gray-200 font-medium text-gray-700 dark:bg-gray-700 dark:text-gray-200",
    small ? "px-2 py-0.5 text-xs" : "px-3 py-1 text-sm",
  ]}>{name}</span
>
