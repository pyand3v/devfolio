---
interface Props {
  name: string
  small?: boolean
}
const { name, small = false } = Astro.props
---

<span
  class:list={[
    "inline-flex items-center border border-[#11151b]/35 bg-transparent font-bold text-[#11151b]",
    small ? "px-2 py-0.5 text-xs" : "px-3 py-1 text-sm",
  ]}>{name}</span
>
