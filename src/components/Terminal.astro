---
// A dark terminal window, taped to the page
interface Props {
  title?: string
  class?: string
  tilt?: string
}

const { title, class: className, tilt = "0deg" } = Astro.props
---

<div class:list={["terminal tape tape-note", className]} style={`transform: rotate(${tilt})`}>
  <div class="terminal-bar" aria-hidden="true">
    <span class="dot"></span>
    <span class="dot"></span>
    <span class="dot"></span>
    {title && <span class="ml-1.5">{title}</span>}
  </div>
  <div class="px-4 py-3.5 text-[0.8125rem] leading-[1.9]">
    <slot />
  </div>
</div>
