---
import { Icon } from "astro-icon/components"
import type { WorkItem } from "@/lib/content"
import { calculateDuration, formatDateRange } from "@/lib/utils"
interface Props {
  item: WorkItem
}
const { item } = Astro.props
---

<a href={`/work/${item.slug}`} class="group block">
  <article
    class="rounded-xl border border-gray-300 bg-gray-100 p-4 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-accent-500 hover:bg-gray-200 hover:shadow-lg dark:border-gray-700 dark:bg-gray-900 dark:hover:bg-gray-800"
  >
    <div class="flex items-center">
      {
        item.logoUrl && (
          <img
            src={item.logoUrl}
            alt={`${item.company} logo`}
            width="25"
            height="25"
            class="mr-4 rounded-full"
            loading="lazy"
          />
        )
      }
      <h3 class="text-xl font-semibold transition group-hover:text-accent-500">
        {item.title} @ {item.company}
      </h3>
    </div>
    <div class="mt-2 flex flex-col text-gray-500 sm:flex-row sm:items-center">
      <div class="flex items-center gap-2">
        <Icon name="lucide:calendar-days" class="size-4" /><span
          >{formatDateRange(item.start, item.end)}</span
        ><span>·</span><span>{calculateDuration(item.start, item.end)}</span>
      </div>
      {
        item.locations.length > 0 && (
          <div class="mt-1 flex items-center sm:ml-2 sm:mt-0">
            <>
              <span class="mx-2 hidden sm:inline">|</span>
              <Icon name="lucide:map-pin" class="mr-1 size-4" />
              <span>{item.locations.join(", ")}</span>
            </>
          </div>
        )
      }
    </div>
    <p class="mt-2 text-gray-700 dark:text-gray-300">{item.description}</p>
  </article>
</a>
