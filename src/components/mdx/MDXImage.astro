---
interface Props {
  src?: string
  alt?: string
  title?: string
  width?: string | number
  height?: string | number
}
const { src, alt = "", title, width, height } = Astro.props
---

{src && (
  <figure class="not-prose my-8">
    <img
      src={src}
      alt={alt}
      title={title}
      width={width}
      height={height}
      loading="lazy"
      class="max-h-[36rem] w-full rounded-md border-[1.5px] border-ink bg-paper object-contain shadow-[4px_4px_0_var(--grid-strong)]"
    />
    {title && <figcaption class="hand mt-3 text-center text-xl text-annot">{title}</figcaption>}
  </figure>
)}
