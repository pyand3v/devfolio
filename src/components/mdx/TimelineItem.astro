---
import { Icon } from "astro-icon/components"
interface Props {
  title: string
  duration: string
  location: string
}
const { title, duration, location } = Astro.props
---

<section class="relative">
  <span class="graph-node absolute top-1.5 -left-8" aria-hidden="true"></span>
  <h3 class="display text-xl text-ink">{title}</h3>
  <div class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-muted">
    <span class="inline-flex items-center gap-1.5 text-accent">
      <Icon name="lucide:calendar-days" class="size-3.5" />
      {duration}
    </span>
    <span class="inline-flex items-center gap-1.5">
      <Icon name="lucide:map-pin" class="size-3.5" />
      {location}
    </span>
  </div>
  <div class="prose mt-3 max-w-none text-ink-soft [&>*:first-child]:mt-0 [&>*:last-child]:mb-0">
    <slot />
  </div>
</section>
