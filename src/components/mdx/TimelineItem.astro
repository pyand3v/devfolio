---
import { Icon } from "astro-icon/components"
interface Props {
  title: string
  duration: string
  location: string
}
const { title, duration, location } = Astro.props
---

<section
  class="relative rounded-lg border border-gray-200 bg-gray-50 p-4 shadow-sm dark:border-gray-700 dark:bg-gray-900"
>
  <span
    class="absolute -left-[33px] top-5 size-4 rounded-full border-4 border-white bg-accent-500 dark:border-zinc-950"
  ></span><h3 class="font-bold text-gray-900 dark:text-white">{title}</h3><div
    class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-500"
  >
    <span class="inline-flex items-center gap-1"
      ><Icon name="lucide:calendar-days" class="size-3.5" />{duration}</span
    ><span class="inline-flex items-center gap-1"
      ><Icon name="lucide:map-pin" class="size-3.5" />{location}</span
    >
  </div><div class="mt-3 text-gray-700 dark:text-gray-300"><slot /></div>
</section>
