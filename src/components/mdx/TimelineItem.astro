---
import { Icon } from "astro-icon/components"
interface Props {
  title: string
  duration: string
  location: string
}
const { title, duration, location } = Astro.props
---

<section class="relative border border-white/25 border-l-4 border-l-[#88c0d0] bg-[#3b4252] p-5 text-white">
  <span class="absolute -left-[37px] top-6 size-4 rounded-full border-4 border-[#2e3440] bg-[#88c0d0]"></span>
  <div class="not-prose">
    <h3 class="display-type text-2xl text-white">{title}</h3>
    <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs font-bold tracking-wide text-[#8fbcbb] uppercase">
      <span class="inline-flex items-center gap-1.5">
        <Icon name="lucide:calendar-days" class="size-3.5" />
        {duration}
      </span>
      <span class="inline-flex items-center gap-1.5 text-white/60">
        <Icon name="lucide:map-pin" class="size-3.5" />
        {location}
      </span>
    </div>
  </div>
  <div class="mt-3 text-white/75 [&>*:first-child]:mt-0 [&>*:last-child]:mb-0">
    <slot />
  </div>
</section>
