---
import "@fontsource/gabarito/400.css"
import "@fontsource/gabarito/500.css"
import "@fontsource/gabarito/600.css"
import "@fontsource/gabarito/700.css"
import "@/styles/globals.css"
import Header from "@/components/Header.astro"
import Footer from "@/components/Footer.astro"
import { siteMetadata } from "@/data/site"
import { getLocaleFromPathname } from "@/lib/i18n"
import { rssPath, rssTitle } from "@/lib/rss"
import Analytics from "@vercel/analytics/astro"
import SpeedInsights from "@vercel/speed-insights/astro"
import localeRedirect from "@/scripts/locale-redirect.js?raw"

interface Props {
  title?: string
  description?: string
  canonical?: string
  /** Pass null for pages such as a 404 that should not be shared or indexed. */
  ogImage?: string | null
  noIndex?: boolean
  pageTitle?: string
  pageSubtitle?: string
  isBlogPost?: boolean
  jsonLd?: object
}

const {
  title,
  description = siteMetadata.description,
  canonical = Astro.url.pathname,
  ogImage,
  noIndex = false,
  isBlogPost,
  jsonLd,
} = Astro.props
const fullTitle = title ? `${title} | ${siteMetadata.title}` : siteMetadata.title
const url = new URL(canonical, siteMetadata.siteUrl).toString()
const locale = getLocaleFromPathname(Astro.url.pathname)
const socialImage =
  ogImage === null
    ? null
    : new URL(
        ogImage ?? `${canonical === "/" ? "" : canonical}/opengraph-image`,
        siteMetadata.siteUrl
      ).toString()
---

<!doctype html>
<html lang={locale} data-theme={siteMetadata.theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <script is:inline set:html={localeRedirect} />
    <meta name="description" content={description} />
    <meta name="keywords" content={siteMetadata.keywords.join(", ")} />
    <meta name="author" content={siteMetadata.author.name} />
    <meta
      name="robots"
      content={
        noIndex
          ? "noindex, nofollow"
          : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
      }
    />
    <link rel="canonical" href={url} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${rssTitle(siteMetadata.title, locale)} RSS`}
      href={rssPath(locale)}
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={siteMetadata.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    {socialImage && (
      <>
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content={siteMetadata.social.twitter} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <title>{fullTitle}</title>
    {jsonLd && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
      />
    )}
  </head>
  <body class="portfolio-shell flex min-h-screen flex-col overscroll-none font-[Gabarito,Arial,sans-serif] antialiased">
    <Header pathname={Astro.url.pathname} isBlogPost={isBlogPost} />
    <main class="grow">
      <slot />
    </main>
    <Footer />
    <Analytics />
    <SpeedInsights />
    <script>
      import "@/scripts/site"
    </script>
  </body>
</html>
