---
import "@fontsource/gabarito/400.css"
import "@fontsource/gabarito/500.css"
import "@fontsource/gabarito/600.css"
import "@fontsource/gabarito/700.css"
import "@/styles/globals.css"
import Header from "@/components/Header.astro"
import Footer from "@/components/Footer.astro"
import { siteMetadata } from "@/data/site"
import Analytics from "@vercel/analytics/astro"
import SpeedInsights from "@vercel/speed-insights/astro"

interface Props {
  title?: string
  description?: string
  canonical?: string
  /** Pass null for pages such as a 404 that should not be shared or indexed. */
  ogImage?: string | null
  noIndex?: boolean
  pageTitle?: string
  pageSubtitle?: string
  isBlogPost?: boolean
  jsonLd?: object
}

const {
  title,
  description = siteMetadata.description,
  canonical = Astro.url.pathname,
  ogImage,
  noIndex = false,
  pageTitle,
  pageSubtitle,
  isBlogPost,
  jsonLd,
} = Astro.props
const fullTitle = title ? `${title} | ${siteMetadata.title}` : siteMetadata.title
const url = new URL(canonical, siteMetadata.siteUrl).toString()
const socialImage =
  ogImage === null
    ? null
    : new URL(
        ogImage ?? `${canonical === "/" ? "" : canonical}/opengraph-image`,
        siteMetadata.siteUrl
      ).toString()
---

<!doctype html>
<html lang="en" data-theme={siteMetadata.theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <meta name="description" content={description} />
    <meta name="keywords" content={siteMetadata.keywords.join(", ")} />
    <meta name="author" content={siteMetadata.author.name} />
    <meta
      name="robots"
      content={noIndex
        ? "noindex, nofollow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <link rel="canonical" href={url} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteMetadata.title} RSS`}
      href="/rss.xml"
    />
    <link rel="icon" href="/icons/favicon.ico" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={siteMetadata.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    {
      socialImage && (
        <>
          <meta property="og:image" content={socialImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content={siteMetadata.social.twitter} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <title>{fullTitle}</title>
    {
      jsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
        />
      )
    }
    <script is:inline>
      const storedTheme = localStorage.getItem("theme") || "system"
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches
      document.documentElement.classList.toggle(
        "dark",
        storedTheme === "dark" || (storedTheme === "system" && prefersDark)
      )
      document.documentElement.dataset.theme =
        localStorage.getItem("accent-theme") || document.documentElement.dataset.theme || "blue"
    </script>
  </head>
  <body
    class="flex min-h-screen flex-col overscroll-none bg-white font-[Gabarito,Arial,sans-serif] antialiased transition-colors dark:bg-zinc-950"
  >
    <div
      class="pointer-events-none fixed inset-0 -z-10 bg-[radial-gradient(circle,#d1d5db_1px,transparent_1px)] bg-size-[30px_30px] mask-[radial-gradient(ellipse_50%_50%_at_50%_50%,#000_60%,transparent_100%)] dark:bg-[radial-gradient(circle,#3f3f46_1px,transparent_1px)]"
    >
    </div>
    <Header
      pathname={Astro.url.pathname}
      title={pageTitle}
      subtitle={pageSubtitle}
      isBlogPost={isBlogPost}
    />
    <main class="container mx-auto grow px-4 py-6"><slot /></main>
    <Footer />
    <Analytics />
    <SpeedInsights />
    <script>
      import "@/scripts/site"
    </script>
  </body>
</html>
