---
import { Icon } from "astro-icon/components"
import BaseLayout from "@/layouts/BaseLayout.astro"
---

<BaseLayout
  title="Page not found"
  description="The page you requested does not exist."
  noIndex
  ogImage={null}
  ><section class="mx-auto max-w-xl px-4 py-16 text-center">
    <Icon name="lucide:circle-alert" class="mx-auto mb-5 size-14 text-accent-500" /><h1
      class="mb-3 text-3xl font-bold"
    >
      Page not found
    </h1><p class="mb-8 text-gray-600 dark:text-gray-300">
      The page you requested does not exist or may have moved.
    </p><a
      href="/"
      class="inline-flex items-center gap-2 rounded-lg bg-accent-600 px-4 py-2 font-semibold text-white transition hover:bg-accent-700"
      ><Icon name="lucide:arrow-left" class="size-4" />Back home</a
    >
  </section></BaseLayout
>
