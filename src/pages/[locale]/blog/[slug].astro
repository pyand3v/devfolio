---
import BaseLayout from "@/layouts/BaseLayout.astro"
import BlogArticleContent from "@/components/BlogArticleContent.astro"
import { homeIntroConfig } from "@/data/portfolio"
import { siteMetadata } from "@/data/site"
import { getAllBlogPosts } from "@/lib/content"
import { locales, type Locale } from "@/lib/i18n"

export async function getStaticPaths() {
  const paths = await Promise.all(
    locales
      .filter(locale => locale !== "en")
      .map(async locale => {
        const posts = await getAllBlogPosts(locale, { featuredOnly: false })
        return posts.map(post => ({ params: { locale, slug: post.slug }, props: { post } }))
      })
  )
  return paths.flat()
}

const { post } = Astro.props
const locale = Astro.params.locale as Locale
// Without a translation the page shows the English post, so that's the canonical version
const translated = post.locale === locale
const canonical = translated ? `/${locale}/blog/${post.slug}` : `/blog/${post.slug}`
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.summary,
  image: `${siteMetadata.siteUrl}${canonical}/opengraph-image`,
  datePublished: post.publishedAt,
  dateModified: post.updatedAt,
  url: `${siteMetadata.siteUrl}${canonical}`,
  keywords: post.tags?.join(", "),
  author: { "@type": "Person", name: homeIntroConfig.name, url: siteMetadata.siteUrl },
}
---

<BaseLayout
  title={post.title}
  description={post.summary}
  canonical={canonical}
  translations={translated ? post.availableLanguages : []}
  ogImage={`${canonical}/opengraph-image`}
  isBlogPost
  jsonLd={jsonLd}
>
  <BlogArticleContent post={post} locale={locale} />
</BaseLayout>
