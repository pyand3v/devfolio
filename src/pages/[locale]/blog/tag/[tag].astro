---
import BaseLayout from "@/layouts/BaseLayout.astro"
import TagLanding from "@/components/TagLanding.astro"
import { getAllBlogPosts } from "@/lib/content"
import { copy, locales, type Locale } from "@/lib/i18n"

export async function getStaticPaths() {
  const paths = await Promise.all(
    locales
      .filter(locale => locale !== "en")
      .map(async locale => {
        const posts = await getAllBlogPosts(locale, { featuredOnly: false })
        const tags = [
          ...new Set(posts.flatMap(post => post.tags ?? []).map(tag => tag.toLowerCase())),
        ]
        return tags.map(tag => ({ params: { locale, tag } }))
      })
  )
  return paths.flat()
}

const locale = Astro.params.locale as Locale
const { tag } = Astro.params
const posts = (await getAllBlogPosts(locale, { featuredOnly: false })).filter(post =>
  post.tags?.includes(tag ?? "")
)
const displayTag = tag?.replaceAll("-", " ") ?? ""
const labels = copy[locale].tag
---

<BaseLayout
  title={`${labels.title} ${displayTag}`}
  description={`${labels.description} ${displayTag}.`}
  canonical={`/${locale}/blog/tag/${tag}`}
  translations={[]}
  ogImage="/blog/opengraph-image"
>
  <TagLanding tag={tag ?? ""} posts={posts} locale={locale} />
</BaseLayout>
