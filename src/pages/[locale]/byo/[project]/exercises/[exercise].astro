---
import BaseLayout from "@/layouts/BaseLayout.astro"
import ByoArticle from "@/components/ByoArticle.astro"
import { getAllByoProjects, type ByoExercise, type ByoProjectBundle } from "@/lib/content"
import { locales, type Locale } from "@/lib/i18n"
export async function getStaticPaths() {
  return (
    await Promise.all(
      locales
        .filter(locale => locale !== "en")
        .map(async locale =>
          (await getAllByoProjects(locale)).flatMap(bundle =>
            bundle.exercises.map(entry => ({
              params: { locale, project: bundle.project.data.slug, exercise: entry.data.slug },
              props: { bundle, entry, locale },
            }))
          )
        )
    )
  ).flat()
}
const { bundle, entry, locale } = Astro.props as {
  bundle: ByoProjectBundle
  entry: ByoExercise
  locale: Locale
}
const canonical = `/byo/${bundle.project.data.slug}/exercises/${entry.data.slug}`
---

<BaseLayout title={entry.data.title} description={entry.data.description} canonical={canonical}
  ><ByoArticle bundle={bundle} entry={entry} locale={locale} /></BaseLayout
>
