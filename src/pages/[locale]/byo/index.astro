---
import BaseLayout from "@/layouts/BaseLayout.astro"
import ByoCatalog from "@/components/ByoCatalog.astro"
import { getAllByoProjects } from "@/lib/content"
import { copy, locales, type Locale } from "@/lib/i18n"
export async function getStaticPaths() {
  return Promise.all(
    locales
      .filter(locale => locale !== "en")
      .map(async locale => ({
        params: { locale },
        props: { bundles: await getAllByoProjects(locale), locale },
      }))
  )
}
const { bundles, locale } = Astro.props as {
  bundles: Awaited<ReturnType<typeof getAllByoProjects>>
  locale: Locale
}
---

<BaseLayout
  title={copy[locale].pages.byoTitle}
  description={copy[locale].pages.byoDescription}
  canonical={`/${locale}/byo`}
>
  <ByoCatalog bundles={bundles} locale={locale} />
</BaseLayout>
