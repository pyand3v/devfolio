---
import BaseLayout from "@/layouts/BaseLayout.astro"
import CollectionLanding from "@/components/CollectionLanding.astro"
import { copy, locales, type Locale } from "@/lib/i18n"

export function getStaticPaths() {
  return locales.filter(locale => locale !== "en").map(locale => ({ params: { locale } }))
}

const locale = Astro.params.locale as Locale
---

<BaseLayout title={copy[locale].nav.projects} description={copy[locale].pages.projectsDescription}>
  <CollectionLanding locale={locale} kind="projects" />
</BaseLayout>
