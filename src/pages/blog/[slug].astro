---
import { getCollection, render } from "astro:content"
import { Icon } from "astro-icon/components"
import BaseLayout from "@/layouts/BaseLayout.astro"
import BlogCard from "@/components/BlogCard.astro"
import { homeIntroConfig } from "@/data/portfolio"
import { siteMetadata } from "@/data/site"
import { getAllBlogPosts } from "@/lib/content"
import { formatBlogDate, getReadingTime } from "@/lib/utils"

export async function getStaticPaths() {
  const posts = await getCollection("blog")
  return posts.map(post => ({ params: { slug: post.id.replace(/\.mdx$/, "") }, props: { post } }))
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const allPosts = await getAllBlogPosts()
const slug = post.id.replace(/\.mdx$/, "")
const similar = allPosts
  .filter(
    entry =>
      entry.slug !== slug &&
      entry.tags?.some(tag => post.data.tags?.map(value => value.toLowerCase()).includes(tag))
  )
  .slice(0, 3)
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.summary,
  image: `${siteMetadata.siteUrl}/blog/${slug}/opengraph-image`,
  datePublished: new Date(post.data.date).toISOString(),
  url: `${siteMetadata.siteUrl}/blog/${slug}`,
  keywords: post.data.tags?.join(", "),
  author: { "@type": "Person", name: homeIntroConfig.name, url: siteMetadata.siteUrl },
}
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  canonical={`/blog/${slug}`}
  pageTitle={post.data.title}
  pageSubtitle={`${homeIntroConfig.name}'s Blog · ${formatBlogDate(post.data.date, "short")}`}
  isBlogPost
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-4xl px-4">
    <a
      href="/blog"
      class="mb-6 inline-flex items-center gap-1 text-sm font-semibold text-accent-600 transition hover:gap-2 dark:text-accent-400"
      ><Icon name="lucide:arrow-left" class="size-4" />Back to Blog</a
    >
    <h1 class="mb-4 text-3xl font-bold text-gray-900 dark:text-white">{post.data.title}</h1>
    <div class="mb-8 flex flex-wrap items-center gap-x-4 gap-y-1 text-gray-500">
      <span class="flex items-center gap-1.5"
        ><Icon name="lucide:calendar-days" class="size-4" />{formatBlogDate(post.data.date)}</span
      ><span class="flex items-center gap-1.5"
        ><Icon name="lucide:book-open" class="size-4" />{getReadingTime(post.body ?? "")} min read</span
      >
    </div>
    {
      post.data.tags && (
        <div class="mb-8 flex flex-wrap gap-2">
          {post.data.tags.map(tag => (
            <a
              href={`/blog/tag/${encodeURIComponent(tag.toLowerCase())}`}
              class="rounded-full bg-accent-500/10 px-2.5 py-1 text-sm font-semibold text-accent-700 hover:bg-accent-500/20 dark:text-accent-400"
            >
              <Icon name="lucide:tag" class="mr-1 inline size-3.5" />
              {tag}
            </a>
          ))}
        </div>
      )
    }
    {
      headings.length > 0 && (
        <details class="mb-8 rounded-lg border border-gray-200 bg-gray-50 p-4 dark:border-gray-700 dark:bg-gray-900">
          <>
            <summary class="cursor-pointer font-semibold">Table of contents</summary>
            <ol class="mt-3 space-y-1 text-sm">
              {headings
                .filter(heading => heading.depth <= 3)
                .map(heading => (
                  <li class:list={[heading.depth === 3 && "ml-4"]}>
                    <a
                      href={`#${heading.slug}`}
                      class="text-gray-600 hover:text-accent-600 dark:text-gray-300 dark:hover:text-accent-400"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
            </ol>
          </>
        </details>
      )
    }
    <div class="prose max-w-full overflow-hidden dark:prose-invert"><Content /></div>
    {
      similar.length > 0 && (
        <section class="mt-12">
          <>
            <h2 class="mb-4 text-2xl font-bold">Other posts that might interest you</h2>
            <div class="grid gap-6">
              {similar.map(entry => (
                <BlogCard post={entry} />
              ))}
            </div>
          </>
        </section>
      )
    }
  </article>
</BaseLayout>
