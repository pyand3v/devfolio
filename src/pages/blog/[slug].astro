---
import { getCollection, render } from "astro:content"
import { Icon } from "astro-icon/components"
import BaseLayout from "@/layouts/BaseLayout.astro"
import BlogCard from "@/components/BlogCard.astro"
import { homeIntroConfig } from "@/data/portfolio"
import { siteMetadata } from "@/data/site"
import { featuredBlogPostSlugs, getAllBlogPosts } from "@/lib/content"
import { formatBlogDate, getReadingTime } from "@/lib/utils"

export async function getStaticPaths() {
  const posts = await getCollection("blog")
  return posts
    .filter(post => featuredBlogPostSlugs.has(post.id.replace(/\.mdx$/, "")))
    .map(post => ({ params: { slug: post.id.replace(/\.mdx$/, "") }, props: { post } }))
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const allPosts = await getAllBlogPosts()
const slug = post.id.replace(/\.mdx$/, "")
const similar = allPosts
  .filter(
    entry =>
      entry.slug !== slug &&
      entry.tags?.some(tag => post.data.tags?.map(value => value.toLowerCase()).includes(tag))
  )
  .slice(0, 3)
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.summary,
  image: `${siteMetadata.siteUrl}/blog/${slug}/opengraph-image`,
  datePublished: new Date(post.data.date).toISOString(),
  url: `${siteMetadata.siteUrl}/blog/${slug}`,
  keywords: post.data.tags?.join(", "),
  author: { "@type": "Person", name: homeIntroConfig.name, url: siteMetadata.siteUrl },
}
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  canonical={`/blog/${slug}`}
  pageSubtitle={`${homeIntroConfig.name}'s Blog · ${formatBlogDate(post.data.date, "short")}`}
  isBlogPost
  jsonLd={jsonLd}
>
  <section class="min-h-screen bg-[#11151b] text-white">
    <article class="mx-auto max-w-7xl px-5 py-8 lg:px-8 lg:py-12">
      <a
        href="/blog"
        class="mb-8 inline-flex items-center gap-1 text-sm font-semibold text-[#d7df72] transition hover:gap-2 hover:text-white"
        ><Icon name="lucide:arrow-left" class="size-4" />Back to Blog</a
      >
      <h1 class="display-type mb-5 text-4xl leading-[0.95] text-white sm:text-5xl">
        {post.data.title}
      </h1>
      <div class="mb-8 flex flex-wrap items-center gap-x-4 gap-y-1 text-white/55">
        <span class="flex items-center gap-1.5"
          ><Icon name="lucide:calendar-days" class="size-4" />{formatBlogDate(post.data.date)}</span
        ><span class="flex items-center gap-1.5"
          ><Icon name="lucide:book-open" class="size-4" />{getReadingTime(post.body ?? "")} min read</span
        >
      </div>
      {
        post.data.tags && (
          <div class="mb-8 flex flex-wrap gap-2">
            {post.data.tags.map(tag => (
              <a
                href={`/blog/tag/${encodeURIComponent(tag.toLowerCase())}`}
                class="border border-[#d7df72]/50 bg-[#d7df72]/8 px-2.5 py-1 text-sm font-semibold text-[#d7df72] transition hover:border-[#c86d61] hover:bg-[#c86d61] hover:text-white"
              >
                <Icon name="lucide:tag" class="mr-1 inline size-3.5" />
                {tag}
              </a>
            ))}
          </div>
        )
      }
      <div
        class:list={[
          "mt-10",
          headings.length > 0 &&
            "lg:grid lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-12 xl:grid-cols-[16rem_minmax(0,1fr)]",
        ]}
      >
        {
          headings.length > 0 && (
            <aside class="mb-10 border-l-2 border-[#c86d61] pl-5 lg:sticky lg:top-28 lg:mb-0 lg:self-start">
              <p class="text-xs font-black tracking-[0.16em] text-[#c86d61] uppercase">
                On this page
              </p>
              <nav class="mt-4" aria-label="Table of contents">
                <ol class="space-y-2 text-sm leading-snug">
                  {headings
                    .filter(heading => heading.depth <= 3)
                    .map(heading => (
                      <li class:list={[heading.depth === 3 && "ml-3"]}>
                        <a
                          href={`#${heading.slug}`}
                          class="text-white/60 transition hover:text-[#d7df72] focus-visible:text-[#d7df72] focus-visible:outline-none"
                        >
                          {heading.text}
                        </a>
                      </li>
                    ))}
                </ol>
              </nav>
            </aside>
          )
        }
        <div class="min-w-0">
          <div
            class="prose prose-invert max-w-full overflow-hidden prose-headings:text-white prose-p:text-white/78 prose-strong:text-white prose-a:text-[#d7df72] prose-a:decoration-[#d7df72]/45 hover:prose-a:text-white"
          >
            <Content />
          </div>
          {
            similar.length > 0 && (
              <section class="mt-12">
                <>
                  <h2 class="mb-4 text-2xl font-bold text-white">
                    Other posts that might interest you
                  </h2>
                  <div class="grid gap-6">
                    {similar.map(entry => (
                      <BlogCard post={entry} surface="contrast" />
                    ))}
                  </div>
                </>
              </section>
            )
          }
        </div>
      </div>
    </article>
  </section>
</BaseLayout>
