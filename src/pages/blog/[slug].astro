---
import BaseLayout from "@/layouts/BaseLayout.astro"
import BlogArticleContent from "@/components/BlogArticleContent.astro"
import { siteMetadata } from "@/data/site"
import { getAllBlogPosts } from "@/lib/content"
import { blogPosting } from "@/lib/structured-data"

export async function getStaticPaths() {
  const posts = await getAllBlogPosts("en", { featuredOnly: false })
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }))
}

const { post } = Astro.props
const canonical = `/blog/${post.slug}`
const jsonLd = blogPosting(post, `${siteMetadata.siteUrl}${canonical}`)
---

<BaseLayout
  title={post.title}
  description={post.summary}
  canonical={canonical}
  isBlogPost
  jsonLd={jsonLd}
>
  <BlogArticleContent post={post} locale="en" />
</BaseLayout>
