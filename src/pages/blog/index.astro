---
import BaseLayout from "@/layouts/BaseLayout.astro"
import BlogCard from "@/components/BlogCard.astro"
import { getAllBlogPosts } from "@/lib/content"

const posts = await getAllBlogPosts()
---

<BaseLayout
  title="Blog"
  description="Read my latest blog posts about software development, technology, and more."
>
  <section class="relative isolate mx-auto max-w-5xl px-4 py-4 sm:py-8">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-28 bottom-0 -z-10 rounded-[2rem] bg-linear-to-b from-white/70 via-white/25 to-transparent dark:from-zinc-950/55 dark:via-zinc-950/15"
    >
    </div>
    <header class="mb-8 max-w-2xl">
      <p
        class="mb-2 text-sm font-bold tracking-[0.18em] text-accent-600 uppercase dark:text-accent-400"
      >
        Notes from the desk
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-gray-950 sm:text-4xl dark:text-white">
        Blog
      </h1>
      <p class="mt-3 text-base leading-relaxed text-gray-600 dark:text-gray-300">
        Practical notes on systems, infrastructure, and engineering practices behind reliable
        products.
      </p>
    </header>
    <div class="grid gap-4 lg:grid-cols-2 lg:gap-5">
      {posts.map(post => <BlogCard post={post} />)}
    </div>
  </section>
</BaseLayout>
