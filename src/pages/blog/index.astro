---
import BaseLayout from "@/layouts/BaseLayout.astro"
import BlogCard from "@/components/BlogCard.astro"
import CollectionBrowser from "@/components/CollectionBrowser.astro"
import { paginationConfig } from "@/data/portfolio"
import { getAllBlogPosts } from "@/lib/content"

const posts = await getAllBlogPosts()
const counts = new Map<string, number>()
posts.flatMap(post => post.tags ?? []).forEach(tag => counts.set(tag, (counts.get(tag) ?? 0) + 1))
const filters = [...counts]
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([name, count]) => ({ name, count }))
---

<BaseLayout
  title="Blog"
  description="Read my latest blog posts about software development, technology, and more."
>
  <section class="relative isolate mx-auto max-w-5xl px-4 py-4 sm:py-8">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-28 bottom-0 -z-10 rounded-[2rem] bg-linear-to-b from-white/70 via-white/25 to-transparent dark:from-zinc-950/55 dark:via-zinc-950/15"
    >
    </div>
    <header class="mb-8 max-w-2xl">
      <p
        class="mb-2 text-sm font-bold tracking-[0.18em] text-accent-600 uppercase dark:text-accent-400"
      >
        Notes from the desk
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-gray-950 sm:text-4xl dark:text-white">
        Blog
      </h1>
      <p class="mt-3 text-base leading-relaxed text-gray-600 dark:text-gray-300">
        Practical notes on software engineering, systems, frontend work, and the tools behind them.
      </p>
    </header>
    <CollectionBrowser
      kind="blog"
      filters={filters}
      pageSize={paginationConfig.blogPostsPerPage}
      filterLabel="Filter by Tag"
      searchPlaceholder="Search articles, topics, or keywords"
      enableViewToggle
      sortOptions={[
        { value: "desc", label: "Newest First" },
        { value: "asc", label: "Oldest First" },
      ]}
    /><div class="grid gap-4 lg:grid-cols-2 lg:gap-5" data-collection-items="blog">
      {
        posts.map(post => (
          <div
            class="collection-item"
            data-values={(post.tags ?? []).join("|")}
            data-sort-key={post.date}
            data-search={[post.title, post.summary, ...(post.tags ?? [])].join(" ").toLowerCase()}
          >
            <BlogCard post={post} />
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
