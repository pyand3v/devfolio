---
import BaseLayout from "@/layouts/BaseLayout.astro"
import ByoArticle from "@/components/ByoArticle.astro"
import { getAllByoProjects } from "@/lib/content"
export async function getStaticPaths() {
  return (await getAllByoProjects("en")).flatMap(bundle =>
    bundle.exercises.map(entry => ({
      params: { project: bundle.project.data.slug, exercise: entry.data.slug },
      props: { bundle, entry },
    }))
  )
}
const { bundle, entry } = Astro.props
const canonical = `/byo/${bundle.project.data.slug}/exercises/${entry.data.slug}`
---

<BaseLayout title={entry.data.title} description={entry.data.description} canonical={canonical}
  ><ByoArticle bundle={bundle} entry={entry} locale="en" /></BaseLayout
>
