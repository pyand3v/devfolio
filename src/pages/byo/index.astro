---
import BaseLayout from "@/layouts/BaseLayout.astro"
import ByoCatalog from "@/components/ByoCatalog.astro"
import { getAllByoProjects } from "@/lib/content"
const bundles = await getAllByoProjects("en")
---

<BaseLayout
  title="Build Your Own"
  description="Practical build-alongs for making useful digital products."
  canonical="/byo"
>
  <ByoCatalog bundles={bundles} locale="en" />
</BaseLayout>
