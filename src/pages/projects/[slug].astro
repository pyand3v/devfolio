---
import { render } from "astro:content"
import { Icon } from "astro-icon/components"
import BaseLayout from "@/layouts/BaseLayout.astro"
import ArticleSheet from "@/components/ArticleSheet.astro"
import ProjectGallery from "@/components/ProjectGallery.astro"
import TechBadge from "@/components/TechBadge.astro"
import { homeIntroConfig } from "@/data/portfolio"
import { copy } from "@/lib/i18n"
import { siteMetadata } from "@/data/site"
import { formatDuration } from "@/lib/utils"
import { getAllProjects } from "@/lib/content"

export async function getStaticPaths() {
  const projects = await getAllProjects()
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }))
}
const { project } = Astro.props
const { Content, headings } = await render(project.entry)
const images = project.gallery ?? []
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: project.title,
  description: project.description,
  url: `${siteMetadata.siteUrl}/projects/${project.slug}`,
  dateCreated: project.startDate,
  dateModified: project.endDate,
  keywords: project.techStack.join(", "),
  codeRepository: project.githubUrl,
  author: { "@type": "Person", name: homeIntroConfig.name, url: siteMetadata.siteUrl },
}
---

<BaseLayout
  title={project.title}
  description={project.description}
  canonical={`/projects/${project.slug}`}
  translations={[]}
  pageTitle={project.title}
  pageSubtitle={`${homeIntroConfig.name}'s Projects · ${formatDuration(project.startDate, project.endDate)}`}
  jsonLd={jsonLd}
>
  <ArticleSheet
    backHref="/projects"
    backLabel={copy.en.detail.backToProjects}
    path={`projects/${project.slug} · ${formatDuration(project.startDate, project.endDate)}`}
    title={project.title}
    description={project.description}
    headings={headings}
    pagefindSection={copy.en.nav.projects}
  >
    <Fragment slot="meta">
      <dl
        class="mt-6 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs text-muted"
        data-pagefind-ignore
      >
        {project.teamSize && (
          <div class="inline-flex items-center gap-1.5">
            <dt class="inline-flex items-center gap-1.5">
              <Icon name="lucide:users" class="size-3.5 text-accent" />
              {copy.en.detail.teamSize}:
            </dt>
            <dd class="text-ink">{project.teamSize}</dd>
          </div>
        )}
        {project.role && (
          <div class="inline-flex items-center gap-1.5">
            <dt class="inline-flex items-center gap-1.5">
              <Icon name="lucide:briefcase-business" class="size-3.5 text-accent" />
              {copy.en.detail.role}:
            </dt>
            <dd class="text-ink">{project.role}</dd>
          </div>
        )}
      </dl>
      {(project.githubUrl || project.paperUrl) && (
        <div class="mt-5 flex flex-wrap gap-3" data-pagefind-ignore>
          {project.githubUrl && (
            <a href={project.githubUrl} rel="noopener noreferrer" class="btn-ink">
              <Icon name="fa6-brands:github" class="size-4" />
              {copy.en.detail.github}
            </a>
          )}
          {project.paperUrl && (
            <a href={project.paperUrl} rel="noopener noreferrer" class="btn-line">
              <Icon name="lucide:book-open" class="size-4" />
              {copy.en.detail.paper}
            </a>
          )}
        </div>
      )}
      <section class="mt-6" data-pagefind-ignore>
        <h2 class="font-mono text-xs text-accent">{copy.en.detail.techStack}</h2>
        <div class="mt-2 flex flex-wrap gap-1.5">
          {project.techStack.map(name => (
            <TechBadge name={name} />
          ))}
        </div>
      </section>
      <ProjectGallery images={images} />
    </Fragment>
    <Content />
  </ArticleSheet>
</BaseLayout>
