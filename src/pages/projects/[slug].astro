---
import { render } from "astro:content"
import { Icon } from "astro-icon/components"
import BaseLayout from "@/layouts/BaseLayout.astro"
import ContentTableOfContents from "@/components/ContentTableOfContents.astro"
import ProjectGallery from "@/components/ProjectGallery.astro"
import TechBadge from "@/components/TechBadge.astro"
import { homeIntroConfig } from "@/data/portfolio"
import { siteMetadata } from "@/data/site"
import { formatDuration } from "@/lib/utils"
import { getAllProjects } from "@/lib/content"

export async function getStaticPaths() {
  const projects = await getAllProjects()
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }))
}
const { project } = Astro.props
const { Content, headings } = await render(project.entry)
const images = project.gallery ?? []
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: project.title,
  description: project.description,
  url: `${siteMetadata.siteUrl}/projects/${project.slug}`,
  dateCreated: project.startDate,
  dateModified: project.endDate,
  keywords: project.techStack.join(", "),
  codeRepository: project.githubUrl,
  author: { "@type": "Person", name: homeIntroConfig.name, url: siteMetadata.siteUrl },
}
---

<BaseLayout
  title={project.title}
  description={project.description}
  canonical={`/projects/${project.slug}`}
  translations={[]}
  pageTitle={project.title}
  pageSubtitle={`${homeIntroConfig.name}'s Projects · ${formatDuration(project.startDate, project.endDate)}`}
  jsonLd={jsonLd}
>
  <section class="portfolio-dark-grid min-h-screen text-white">
    <article class="mx-auto max-w-4xl px-5 py-8 lg:px-8 lg:py-12">
      <a
        href="/projects"
        class="mb-8 inline-flex items-center gap-2 font-mono text-xs font-bold tracking-[0.12em] text-[#8fbcbb] uppercase transition hover:gap-3 hover:text-white"
      >
        <Icon name="lucide:arrow-left" class="size-4" />
        Back to Projects
      </a>
      <h1 class="display-type mb-3 text-4xl leading-[0.95]">{project.title}</h1>
      <p class="mb-4 text-lg text-white/65">{project.description}</p>
      <div class="mb-8 flex flex-wrap items-center gap-3 font-mono text-xs text-[#8fbcbb] uppercase">
        <span class="inline-flex items-center gap-2 border border-[#8fbcbb]/50 bg-[#8fbcbb]/8 px-3 py-1">
          <Icon name="lucide:clock" />
          {formatDuration(project.startDate, project.endDate)}
        </span>
        {project.teamSize && (
          <span class="inline-flex items-center gap-2 border border-white/25 px-3 py-1 text-white/75">
            <Icon name="lucide:users" />
            Team Size: {project.teamSize}
          </span>
        )}
        {project.role && (
          <span class="inline-flex items-center gap-2 border border-white/25 px-3 py-1 text-white/75">
            <Icon name="lucide:briefcase-business" />
            Role: {project.role}
          </span>
        )}
        {project.githubUrl && (
          <a
            href={project.githubUrl}
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 border border-white/25 px-3 py-1 text-white transition hover:border-[#88c0d0]"
          >
            <Icon name="fa6-brands:github" />
            View on GitHub
          </a>
        )}
        {project.paperUrl && (
          <a
            href={project.paperUrl}
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 border border-white/25 px-3 py-1 text-white transition hover:border-[#88c0d0]"
          >
            <Icon name="lucide:book-open" />
            Read Paper
          </a>
        )}
      </div>
      <section class="mb-8">
        <h2 class="mb-3 flex items-center gap-2 font-mono text-xs font-bold tracking-[0.14em] text-[#8fbcbb] uppercase">
          <Icon name="lucide:layers-3" />
          Tech Stack
        </h2>
        <div class="flex flex-wrap gap-3">
          {project.techStack.map(name => (
            <TechBadge name={name} surface="dark" />
          ))}
        </div>
      </section>
      <ProjectGallery images={images} />
      <div
        class:list={[
          "mt-10",
          headings.length > 0 &&
            "lg:grid lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-12 xl:grid-cols-[16rem_minmax(0,1fr)]",
        ]}
      >
        <ContentTableOfContents headings={headings} />
        <div class="min-w-0">
          <div class="prose prose-invert max-w-full overflow-hidden">
            <Content />
          </div>
        </div>
      </div>
    </article>
  </section>
</BaseLayout>
