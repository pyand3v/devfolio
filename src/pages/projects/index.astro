---
import BaseLayout from "@/layouts/BaseLayout.astro"
import ProjectCard from "@/components/ProjectCard.astro"
import { getAllProjects } from "@/lib/content"
const projects = await getAllProjects()
---

<BaseLayout
  title="Projects"
  description="Browse my portfolio of projects, side projects, and technical work."
  ><section class="mx-auto max-w-4xl px-4">
    <header class="mb-8 max-w-2xl">
      <p
        class="mb-2 text-sm font-bold tracking-[0.18em] text-accent-600 uppercase dark:text-accent-400"
      >
        Selected builds
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-gray-950 sm:text-4xl dark:text-white">
        Projects
      </h1>
      <p class="mt-3 text-base leading-relaxed text-gray-600 dark:text-gray-300">
        A selection of product, systems, and technical experiments built from idea to delivery.
      </p>
    </header>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {projects.map((project, index) => <ProjectCard project={project} eager={index === 0} />)}
    </div>
  </section></BaseLayout
>
