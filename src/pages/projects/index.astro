---
import BaseLayout from "@/layouts/BaseLayout.astro"
import CollectionBrowser from "@/components/CollectionBrowser.astro"
import ProjectCard from "@/components/ProjectCard.astro"
import { paginationConfig } from "@/data/portfolio"
import { getAllProjects } from "@/lib/content"
const projects = await getAllProjects()
const counts = new Map<string, number>()
projects
  .flatMap(project => project.techStack)
  .forEach(tech => counts.set(tech, (counts.get(tech) ?? 0) + 1))
const filters = [...counts]
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([name, count]) => ({ name, count }))
---

<BaseLayout
  title="Projects"
  description="Browse my portfolio of projects, side projects, and technical work."
  ><section class="mx-auto max-w-4xl px-4">
    <h1 class="sr-only">Projects</h1><CollectionBrowser
      kind="projects"
      filters={filters}
      pageSize={paginationConfig.projectsPerPage}
      filterLabel="Filter by Tech"
      sortOptions={[
        { value: "newest", label: "Newest First" },
        { value: "oldest", label: "Oldest First" },
      ]}
    /><div class="grid grid-cols-1 gap-6 sm:grid-cols-2" data-collection-items="projects">
      {
        projects.map((project, index) => (
          <div
            class="collection-item"
            data-values={project.techStack.join("|")}
            data-sort-key={project.endDate === "Present" ? "9999-12" : project.endDate}
          >
            <ProjectCard project={project} eager={index === 0} />
          </div>
        ))
      }
    </div>
  </section></BaseLayout
>
