---
import { render } from "astro:content"
import { Icon } from "astro-icon/components"
import BaseLayout from "@/layouts/BaseLayout.astro"
import ArticleSheet from "@/components/ArticleSheet.astro"
import TechBadge from "@/components/TechBadge.astro"
import { homeIntroConfig } from "@/data/portfolio"
import { copy } from "@/lib/i18n"
import { siteMetadata } from "@/data/site"
import { calculateDuration, formatDateRange } from "@/lib/utils"
import { getAllWorkItems } from "@/lib/content"

export async function getStaticPaths() {
  const items = await getAllWorkItems()
  return items.map(item => ({ params: { slug: item.slug }, props: { item } }))
}
const { item } = Astro.props
const { Content, headings } = await render(item.entry)
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "OrganizationRole",
  roleName: item.title,
  startDate: item.start,
  endDate: item.end,
  memberOf: { "@type": "Organization", name: item.company },
  url: `${siteMetadata.siteUrl}/work/${item.slug}`,
}
---

<BaseLayout
  title={`${item.title} at ${item.company}`}
  description={item.description}
  canonical={`/work/${item.slug}`}
  translations={[]}
  pageTitle={`${item.title} @ ${item.company}`}
  pageSubtitle={`${homeIntroConfig.name}'s Work · ${formatDateRange(item.start, item.end)}`}
  jsonLd={jsonLd}
>
  <ArticleSheet
    backHref="/work"
    backLabel={copy.en.detail.backToWork}
    path={`work/${item.slug} · ${formatDateRange(item.start, item.end)} · ${calculateDuration(item.start, item.end)}`}
    title={`${item.title} @ ${item.company}`}
    description={item.description}
    headings={headings}
    pagefindSection={copy.en.nav.work}
  >
    <Fragment slot="meta">
      <div class="mt-6 flex flex-wrap items-center gap-4" data-pagefind-ignore>
        {item.logoUrl && (
          <img
            src={item.logoUrl}
            alt={`${item.company} logo`}
            class="size-12 rounded-full border border-line bg-paper"
          />
        )}
        {item.locations.length > 0 && (
          <p class="inline-flex items-center gap-1.5 font-mono text-xs text-muted">
            <Icon name="lucide:map-pin" class="size-3.5" />
            {item.locations.join(" · ")}
          </p>
        )}
      </div>
      {item.techStack && (
        <section class="mt-6" data-pagefind-ignore>
          <h2 class="font-mono text-xs text-accent">{copy.en.detail.techStack}</h2>
          <div class="mt-2 flex flex-wrap gap-1.5">
            {item.techStack.map(name => (
              <TechBadge name={name} />
            ))}
          </div>
        </section>
      )}
    </Fragment>
    <Content />
  </ArticleSheet>
</BaseLayout>
