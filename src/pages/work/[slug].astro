---
import { render } from "astro:content"
import { Icon } from "astro-icon/components"
import BaseLayout from "@/layouts/BaseLayout.astro"
import ContentTableOfContents from "@/components/ContentTableOfContents.astro"
import TechBadge from "@/components/TechBadge.astro"
import { homeIntroConfig } from "@/data/portfolio"
import { copy } from "@/lib/i18n"
import { siteMetadata } from "@/data/site"
import { formatDateRange } from "@/lib/utils"
import { getAllWorkItems } from "@/lib/content"

export async function getStaticPaths() {
  const items = await getAllWorkItems()
  return items.map(item => ({ params: { slug: item.slug }, props: { item } }))
}
const { item } = Astro.props
const { Content, headings } = await render(item.entry)
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "OrganizationRole",
  roleName: item.title,
  startDate: item.start,
  endDate: item.end,
  memberOf: { "@type": "Organization", name: item.company },
  url: `${siteMetadata.siteUrl}/work/${item.slug}`,
}
---

<BaseLayout
  title={`${item.title} at ${item.company}`}
  description={item.description}
  canonical={`/work/${item.slug}`}
  translations={[]}
  pageTitle={`${item.title} @ ${item.company}`}
  pageSubtitle={`${homeIntroConfig.name}'s Work · ${formatDateRange(item.start, item.end)}`}
  jsonLd={jsonLd}
>
  <section class="portfolio-dark-grid min-h-screen text-white">
    <article
      class="mx-auto max-w-4xl px-5 py-8 lg:px-8 lg:py-12"
      data-pagefind-body
      data-pagefind-meta={`section:${copy.en.nav.work}`}
    >
      <a
        data-pagefind-ignore
        href="/work"
        class="mb-8 inline-flex items-center gap-2 font-mono text-xs font-bold tracking-[0.12em] text-[#8fbcbb] uppercase transition hover:gap-3 hover:text-white"
      >
        <Icon name="lucide:arrow-left" class="size-4" />
        {copy.en.detail.backToWork}
      </a>
      <div class="mb-8 flex items-start gap-4">
        {item.logoUrl && (
          <img src={item.logoUrl} alt={`${item.company} logo`} class="size-12 rounded-full" />
        )}
        <div>
          <h1 class="display-type text-4xl">
            {item.title} @ {item.company}
          </h1>
          <p class="mt-2 text-white/65">{item.description}</p>
        </div>
      </div>
      <div class="mb-8 flex flex-wrap gap-3 font-mono text-xs text-[#8fbcbb] uppercase">
        <span class="inline-flex items-center gap-1.5 border border-[#8fbcbb]/50 bg-[#8fbcbb]/8 px-3 py-1">
          <Icon name="lucide:calendar-days" />
          {formatDateRange(item.start, item.end)}
        </span>
        {item.locations.map(location => (
          <span class="inline-flex items-center gap-1.5 border border-white/25 px-3 py-1 text-white/75">
            <Icon name="lucide:map-pin" />
            {location}
          </span>
        ))}
      </div>
      {item.techStack && (
        <section class="mb-8">
          <>
            <h2 class="mb-3 font-mono text-xs font-bold tracking-[0.14em] text-[#8fbcbb] uppercase">
              {copy.en.detail.techStack}
            </h2>
            <div class="flex flex-wrap gap-2">
              {item.techStack.map(name => (
                <TechBadge name={name} surface="dark" />
              ))}
            </div>
          </>
        </section>
      )}
      <div
        class:list={[
          "mt-10",
          headings.length > 0 &&
            "lg:grid lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-12 xl:grid-cols-[16rem_minmax(0,1fr)]",
        ]}
      >
        <ContentTableOfContents headings={headings} />
        <div class="min-w-0">
          <div class="prose prose-invert max-w-full overflow-hidden">
            <Content />
          </div>
        </div>
      </div>
    </article>
  </section>
</BaseLayout>
