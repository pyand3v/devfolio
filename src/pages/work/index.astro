---
import BaseLayout from "@/layouts/BaseLayout.astro"
import CollectionBrowser from "@/components/CollectionBrowser.astro"
import WorkCard from "@/components/WorkCard.astro"
import { paginationConfig } from "@/data/portfolio"
import { getAllWorkItems } from "@/lib/content"
const work = await getAllWorkItems()
const counts = new Map<string, number>()
work.forEach(item => counts.set(item.company, (counts.get(item.company) ?? 0) + 1))
const filters = [...counts]
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([name, count]) => ({ name, count }))
---

<BaseLayout title="Work" description="Explore my professional work experience and career journey."
  ><section class="mx-auto max-w-4xl px-4">
    <h1 class="sr-only">Work</h1><CollectionBrowser
      kind="work"
      filters={filters}
      pageSize={paginationConfig.workItemsPerPage}
      filterLabel="Filter by Company"
      sortOptions={[
        { value: "newest", label: "Newest First" },
        { value: "oldest", label: "Oldest First" },
      ]}
    /><div class="grid gap-6" data-collection-items="work">
      {
        work.map(item => (
          <div
            class="collection-item"
            data-values={item.company}
            data-sort-key={item.end === "Present" ? "9999-12" : item.end}
          >
            <WorkCard item={item} />
          </div>
        ))
      }
    </div>
  </section></BaseLayout
>
