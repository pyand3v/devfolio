---
import BaseLayout from "@/layouts/BaseLayout.astro"
import WorkCard from "@/components/WorkCard.astro"
import { getAllWorkItems } from "@/lib/content"
const work = await getAllWorkItems()
---

<BaseLayout title="Work" description="Explore my professional work experience and career journey."
  ><section class="mx-auto max-w-4xl px-4">
    <header class="mb-8 max-w-2xl">
      <p
        class="mb-2 text-sm font-bold tracking-[0.18em] text-accent-600 uppercase dark:text-accent-400"
      >
        Career
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-gray-950 sm:text-4xl dark:text-white">
        Work
      </h1>
      <p class="mt-3 text-base leading-relaxed text-gray-600 dark:text-gray-300">
        Selected roles building customer-facing products, platform capabilities, and reliable
        systems.
      </p>
    </header>
    <div class="grid gap-6">
      {work.map(item => <WorkCard item={item} />)}
    </div>
  </section></BaseLayout
>
